@inherits LayoutComponentBase
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    var reqTheme = HttpContextAccessor.HttpContext?.Request.Cookies["spark_theme"];
    var isDark = reqTheme == "dark";
    var themeClass = isDark ? "dark" : "";
    var themeAttr = isDark ? "vristo-dark" : "vristo-light";
}

<!DOCTYPE html>
<html lang="en" class="@themeClass" data-theme="@themeAttr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <Vite />
    <HeadOutlet />
    <!-- Prevent Theme FOUC -->
    <script>
        (function() {
            try {
                var m = document.cookie.match(/(^| )spark_theme=([^;]+)/);
                var cookieTheme = m ? decodeURIComponent(m[2]) : null;
                var theme = localStorage.getItem('spark_theme') || cookieTheme || 'system';
                var isDark = theme === 'dark' || (theme === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
                if (isDark) {
                    document.documentElement.classList.add('dark');
                    document.documentElement.setAttribute('data-theme', 'vristo-dark');
                } else {
                    document.documentElement.classList.remove('dark');
                    document.documentElement.setAttribute('data-theme', 'vristo-light');
                }
            } catch (e) {}
        })();
    </script>
</head>

<body class="bg-[#fafafa] dark:bg-[#060818] text-[#0e1726] dark:text-[#888ea8] min-h-screen antialiased flex flex-col font-nunito">
    <div class="relative min-h-screen flex flex-col">
        <!-- Mobile Sidebar Backdrop Overlay -->
        <div class="sidebar-overlay fixed inset-0 bg-black/60 z-40 transition-opacity cursor-pointer"
             onclick="window.themeManager?.toggleSidebar()"></div>

        <!-- Sidebar Navigation -->
        <AppSidebar />

        <!-- Main Content Wrapper (Fixed Screen, Overflow Hidden, No Outer Scrollbar) -->
        <div class="main-container-content">
            <!-- Top Header (Height 60px, Fixed at Top) -->
            <header class="shrink-0 z-30">
                <AppHeader />
            </header>

            <!-- Page Body Area (Internal Smooth Scroll with Floating Auto-Hide Scrollbar) -->
            <div class="main-content-scroll">
                <main class="flex-1 p-4 sm:p-6 lg:p-8 w-full">
                    @Body
                </main>

                <!-- Bottom Footer (Scrolls at Bottom of Content) -->
                <AppFooter />
            </div>
        </div>

        <!-- Back to Top Floating Action -->
        <AppToTop />

        <!-- Floating Theme Customizer -->
        <AppThemeCustomizer />
    </div>

    <FlashMessages />
    <script src="/_framework/blazor.web.js"></script>
</body>
</html>
