<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Abp.Spark</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.2" />
    <ProjectReference Include="..\Abp.Spark.HttpApi\Abp.Spark.HttpApi.csproj" />
    <ProjectReference Include="..\Abp.Spark.Application\Abp.Spark.Application.csproj" />
    <ProjectReference Include="..\Abp.Spark.EntityFrameworkCore\Abp.Spark.EntityFrameworkCore.csproj" />
    <PackageReference Include="Volo.Abp.Autofac" Version="10.7.1" />
    <PackageReference Include="Volo.Abp.AspNetCore.Serilog" Version="10.7.1" />
    <PackageReference Include="Volo.Abp.Swashbuckle" Version="10.7.1" />
    <PackageReference Include="Vite.AspNetCore" Version="2.4.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Blazored.FluentValidation" Version="2.2.0" />
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Update="Locales\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="EnsureNpmAssets" BeforeTargets="Build" Condition="!Exists('wwwroot\build\assets\app.css')">
    <Message Importance="high" Text="Building frontend Vite assets..." />
    <Exec Command="npm run build" />
  </Target>

</Project>
