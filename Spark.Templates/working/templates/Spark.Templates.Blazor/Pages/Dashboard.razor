@page "/dashboard"
@attribute [Authorize]

<PageTitle>@L["dashboard"]</PageTitle>

<section>
    <article class="space-y-4">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0e1726] dark:text-white font-nunito">
            @L["dashboard"]
        </h1>
        <div class="card bg-white dark:bg-[#0e1726] shadow-sm rounded-2xl">
            <div class="card-body p-6">
                <p class="text-sm font-medium text-[#506690] dark:text-[#888ea8]">
                    @L["logged_in_msg"]
                </p>
            </div>
        </div>
    </article>
</section>