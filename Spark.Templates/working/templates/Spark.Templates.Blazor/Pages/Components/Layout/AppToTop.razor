<div class="fixed bottom-6 right-6 z-50">
    <button id="btn-scroll-to-top"
            type="button"
            class="hidden items-center justify-center w-10 h-10 rounded-full bg-primary text-white shadow-lg hover:bg-primary/90 focus:outline-none transition-all duration-300 transform hover:scale-110 active:scale-95 animate-pulse cursor-pointer"
            onclick="window.themeManager?.scrollToTop()"
            aria-label="Scroll to top"
            title="Scroll to top">
        <!-- Lucide: ArrowUp -->
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m5 12 7-7 7 7"/>
            <path d="M12 19V5"/>
        </svg>
    </button>
</div>
