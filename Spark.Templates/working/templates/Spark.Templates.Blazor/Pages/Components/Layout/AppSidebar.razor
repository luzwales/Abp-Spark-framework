@inject NavigationManager NavigationManager

@code {
    [CascadingParameter] public PageState PageState { get; set; } = default!;

    private bool IsActive(string path)
    {
        var current = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        if (string.IsNullOrEmpty(current) && path == "/") return true;
        return string.Equals("/" + current, path, StringComparison.OrdinalIgnoreCase);
    }
}

<!-- Sidebar Container (Borderless & Soft Shadow) -->
<aside class="app-sidebar flex flex-col">
    <!-- Brand Logo Area (Height aligned with Header h-[60px], no bottom border) -->
    <div class="flex items-center justify-between px-6 h-[60px] min-h-[60px]">
        <a href="/" class="flex items-center gap-2.5 font-bold text-xl text-[#0e1726] dark:text-white tracking-wide">
            <!-- Vristo Style Gradient Square with Lucide Sparkles Icon -->
            <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-primary to-secondary flex items-center justify-center text-white shadow-md">
                <!-- Lucide: Sparkles -->
                <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
                    <path d="M5 3v4"/>
                    <path d="M19 17v4"/>
                    <path d="M3 5h4"/>
                    <path d="M17 19h4"/>
                </svg>
            </div>
            <span class="uppercase font-extrabold text-base bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent font-nunito">
                SPARK
            </span>
        </a>

        <!-- Collapse Button with Lucide ChevronsLeft -->
        <button type="button"
                class="w-8 h-8 rounded-full flex items-center justify-center hover:bg-gray-100 dark:hover:bg-[#191e3a] text-[#888ea8] hover:text-primary dark:hover:text-white transition cursor-pointer"
                onclick="window.themeManager?.toggleSidebar()"
                aria-label="Collapse Sidebar"
                title="Collapse Sidebar">
            <!-- Lucide: ChevronsLeft -->
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m11 17-5-5 5-5"/>
                <path d="m18 17-5-5 5-5"/>
            </svg>
        </button>
    </div>

    <!-- Navigation Scroll Area -->
    <div class="flex-1 overflow-y-auto px-4 py-2 space-y-6">
        <!-- Section: Overview -->
        <div>
            <h2 class="text-[11px] font-extrabold uppercase tracking-wider text-[#888ea8] dark:text-[#506690] px-3 mb-2">
                @L["overview"]
            </h2>
            <ul class="space-y-1 text-sm font-semibold">
                <li>
                    <a href="/"
                       class="flex items-center gap-3 px-3 py-2 rounded-lg transition-colors @(IsActive("/") ? "bg-primary text-white shadow-sm" : "text-[#506690] dark:text-[#888ea8] hover:bg-[#f1f2f3] dark:hover:bg-[#191e3a] hover:text-primary dark:hover:text-white")">
                        <!-- Lucide: House -->
                        <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                            <polyline points="9 22 9 12 15 12 15 22"/>
                        </svg>
                        <span>@L["home"]</span>
                    </a>
                </li>
                @if (PageState.User.IsAuthenticated)
                {
                    <li>
                        <a href="/dashboard"
                           class="flex items-center gap-3 px-3 py-2 rounded-lg transition-colors @(IsActive("/dashboard") ? "bg-primary text-white shadow-sm" : "text-[#506690] dark:text-[#888ea8] hover:bg-[#f1f2f3] dark:hover:bg-[#191e3a] hover:text-primary dark:hover:text-white")">
                            <!-- Lucide: LayoutDashboard -->
                            <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="7" height="9" x="3" y="3" rx="1"/>
                                <rect width="7" height="5" x="14" y="3" rx="1"/>
                                <rect width="7" height="9" x="14" y="12" rx="1"/>
                                <rect width="7" height="5" x="3" y="16" rx="1"/>
                            </svg>
                            <span>@L["dashboard"]</span>
                        </a>
                    </li>
                }
            </ul>
        </div>

        <!-- Section: User Management -->
        @if (PageState.User.IsAuthenticated)
        {
            <div>
                <h2 class="text-[11px] font-extrabold uppercase tracking-wider text-[#888ea8] dark:text-[#506690] px-3 mb-2">
                    @L["account"]
                </h2>
                <ul class="space-y-1 text-sm font-semibold">
                    <li>
                        <a href="/profile/edit"
                           class="flex items-center gap-3 px-3 py-2 rounded-lg transition-colors @(IsActive("/profile/edit") ? "bg-primary text-white shadow-sm" : "text-[#506690] dark:text-[#888ea8] hover:bg-[#f1f2f3] dark:hover:bg-[#191e3a] hover:text-primary dark:hover:text-white")">
                            <!-- Lucide: User -->
                            <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                                <circle cx="12" cy="7" r="4"/>
                            </svg>
                            <span>@L["profile"]</span>
                        </a>
                    </li>
                </ul>
            </div>
        }
        else
        {
            <div>
                <h2 class="text-[11px] font-extrabold uppercase tracking-wider text-[#888ea8] dark:text-[#506690] px-3 mb-2">
                    @L["authentication"]
                </h2>
                <ul class="space-y-1 text-sm font-semibold">
                    <li>
                        <a href="/login"
                           class="flex items-center gap-3 px-3 py-2 rounded-lg transition-colors @(IsActive("/login") ? "bg-primary text-white shadow-sm" : "text-[#506690] dark:text-[#888ea8] hover:bg-[#f1f2f3] dark:hover:bg-[#191e3a] hover:text-primary dark:hover:text-white")">
                            <!-- Lucide: LogIn -->
                            <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                                <polyline points="10 17 15 12 10 7"/>
                                <line x1="15" x2="3" y1="12" y2="12"/>
                            </svg>
                            <span>@L["login"]</span>
                        </a>
                    </li>
                    <li>
                        <a href="/register"
                           class="flex items-center gap-3 px-3 py-2 rounded-lg transition-colors @(IsActive("/register") ? "bg-primary text-white shadow-sm" : "text-[#506690] dark:text-[#888ea8] hover:bg-[#f1f2f3] dark:hover:bg-[#191e3a] hover:text-primary dark:hover:text-white")">
                            <!-- Lucide: UserPlus -->
                            <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                                <circle cx="9" cy="7" r="4"/>
                                <line x1="19" x2="19" y1="8" y2="14"/>
                                <line x1="22" x2="16" y1="11" y2="11"/>
                            </svg>
                            <span>@L["register"]</span>
                        </a>
                    </li>
                </ul>
            </div>
        }

        <!-- Section: Resources -->
        <div>
            <h2 class="text-[11px] font-extrabold uppercase tracking-wider text-[#888ea8] dark:text-[#506690] px-3 mb-2">
                @L["resources"]
            </h2>
            <ul class="space-y-1 text-sm font-semibold">
                <li>
                    <a href="https://spark-framework.net" target="_blank"
                       class="flex items-center justify-between px-3 py-2 rounded-lg text-[#506690] dark:text-[#888ea8] hover:bg-[#f1f2f3] dark:hover:bg-[#191e3a] hover:text-primary dark:hover:text-white transition-colors">
                        <div class="flex items-center gap-3">
                            <!-- Lucide: BookOpen -->
                            <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                            </svg>
                            <span>@L["documentation"]</span>
                        </div>
                        <!-- Lucide: ExternalLink -->
                        <svg class="w-3.5 h-3.5 opacity-60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M15 3h6v6"/>
                            <path d="M10 14 21 3"/>
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                        </svg>
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- User Profile Footer in Sidebar (No border, soft rounded container) -->
    @if (PageState.User.IsAuthenticated)
    {
        <div class="p-3 m-3 rounded-xl bg-gray-50 dark:bg-[#121e32]/40">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2.5 overflow-hidden">
                    <div class="w-8 h-8 rounded-full bg-primary/20 text-primary font-bold text-xs flex items-center justify-center shrink-0">
                        @(string.IsNullOrWhiteSpace(PageState.User.Name) ? "U" : PageState.User.Name[0].ToString().ToUpper())
                    </div>
                    <div class="truncate">
                        <p class="text-xs font-bold text-[#0e1726] dark:text-white truncate">@PageState.User.Name</p>
                        <p class="text-[10px] text-[#888ea8] truncate">@PageState.User.Email</p>
                    </div>
                </div>
                <form action="/logout" method="post" class="m-0">
                    <button type="submit"
                            class="w-7 h-7 rounded-full flex items-center justify-center text-[#888ea8] hover:text-danger hover:bg-danger/10 transition cursor-pointer"
                            title="@L["logout"]">
                        <!-- Lucide: LogOut -->
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                            <polyline points="16 17 21 12 16 7"/>
                            <line x1="21" y1="12" x2="9" y2="12"/>
                        </svg>
                    </button>
                </form>
            </div>
        </div>
    }
</aside>
