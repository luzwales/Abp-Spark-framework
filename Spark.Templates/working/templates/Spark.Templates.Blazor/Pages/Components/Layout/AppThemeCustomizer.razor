<div>
    <!-- Backdrop overlay -->
    <div id="spark-customizer-overlay"
         class="fixed inset-0 bg-black/60 z-[60] transition-opacity duration-300 hidden cursor-pointer"
         onclick="window.themeManager?.closeCustomizer()"></div>

    <!-- Slide-over drawer (Borderless with deep shadow) -->
    <div id="spark-theme-customizer"
         class="fixed top-0 bottom-0 right-0 z-[70] w-full max-w-[360px] bg-white dark:bg-[#0e1726] shadow-[0_0_50px_0_rgba(0,0,0,0.2)] transition-transform duration-300 transform translate-x-full">
        
        <!-- Toggle button hanging on the left edge with Lucide Settings -->
        <button type="button"
                class="absolute -left-11 top-1/2 -translate-y-1/2 w-11 h-10 bg-primary text-white rounded-l-full flex items-center justify-center shadow-lg focus:outline-none cursor-pointer hover:bg-primary/90 transition"
                onclick="window.themeManager?.toggleCustomizer()"
                aria-label="Toggle Settings"
                title="Theme Settings">
            <!-- Lucide: Settings (Spinning) -->
            <svg class="w-5 h-5 animate-spin" style="animation-duration: 8s;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
                <circle cx="12" cy="12" r="3"/>
            </svg>
        </button>

        <!-- Drawer Content -->
        <div class="h-full flex flex-col p-6 overflow-y-auto">
            <div class="flex items-center justify-between pb-4">
                <div>
                    <h4 class="text-base font-bold text-[#0e1726] dark:text-white font-nunito tracking-wide">THEME SETTINGS</h4>
                    <p class="text-xs text-[#888ea8]">Customize look & feel preferences</p>
                </div>
                <!-- Lucide: X -->
                <button type="button" class="w-8 h-8 rounded-full flex items-center justify-center hover:bg-gray-100 dark:hover:bg-[#191e3a] text-[#888ea8] hover:text-[#0e1726] dark:hover:text-white cursor-pointer transition" onclick="window.themeManager?.closeCustomizer()">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 6 6 18"/>
                        <path d="m6 6 12 12"/>
                    </svg>
                </button>
            </div>

            <div class="space-y-6 py-4">
                <!-- Color Scheme -->
                <div>
                    <h5 class="text-sm font-semibold mb-1 text-[#0e1726] dark:text-white">Color Scheme</h5>
                    <p class="text-xs text-[#888ea8] mb-3">Select light, dark or system auto theme.</p>
                    <div class="grid grid-cols-3 gap-2">
                        <!-- Light Button with Lucide Sun -->
                        <button type="button"
                                id="theme-btn-light"
                                class="btn btn-sm btn-ghost bg-gray-100 dark:bg-[#121e32] hover:bg-primary hover:text-white flex flex-col h-auto py-3 gap-1 cursor-pointer rounded-xl transition"
                                onclick="window.themeManager?.setTheme('light')">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="4"/>
                                <path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/>
                                <path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
                            </svg>
                            <span class="text-xs font-semibold">Light</span>
                        </button>
                        <!-- Dark Button with Lucide Moon -->
                        <button type="button"
                                id="theme-btn-dark"
                                class="btn btn-sm btn-ghost bg-gray-100 dark:bg-[#121e32] hover:bg-primary hover:text-white flex flex-col h-auto py-3 gap-1 cursor-pointer rounded-xl transition"
                                onclick="window.themeManager?.setTheme('dark')">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
                            </svg>
                            <span class="text-xs font-semibold">Dark</span>
                        </button>
                        <!-- System Button with Lucide Monitor -->
                        <button type="button"
                                id="theme-btn-system"
                                class="btn btn-sm btn-ghost bg-gray-100 dark:bg-[#121e32] hover:bg-primary hover:text-white flex flex-col h-auto py-3 gap-1 cursor-pointer rounded-xl transition"
                                onclick="window.themeManager?.setTheme('system')">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="20" height="14" x="2" y="3" rx="2"/>
                                <line x1="8" x2="16" y1="21" y2="21"/>
                                <line x1="12" y1="17" x2="12" y2="21"/>
                            </svg>
                            <span class="text-xs font-semibold">System</span>
                        </button>
                    </div>
                </div>

                <!-- Navigation Bar Position -->
                <div class="pt-2">
                    <h5 class="text-sm font-semibold mb-1 text-[#0e1726] dark:text-white">Navbar Type</h5>
                    <p class="text-xs text-[#888ea8] mb-3">Sticky on scroll or static flow.</p>
                    <div class="grid grid-cols-2 gap-2">
                        <label class="flex items-center gap-2 p-2.5 bg-gray-100 dark:bg-[#121e32] rounded-xl cursor-pointer hover:bg-primary/10 text-xs font-medium text-[#0e1726] dark:text-white transition">
                            <input type="radio" name="navbar_type" value="sticky" checked onchange="window.themeManager?.setNavbarType(this.value)" class="radio radio-primary radio-xs" />
                            <span>Sticky</span>
                        </label>
                        <label class="flex items-center gap-2 p-2.5 bg-gray-100 dark:bg-[#121e32] rounded-xl cursor-pointer hover:bg-primary/10 text-xs font-medium text-[#0e1726] dark:text-white transition">
                            <input type="radio" name="navbar_type" value="static" onchange="window.themeManager?.setNavbarType(this.value)" class="radio radio-primary radio-xs" />
                            <span>Static</span>
                        </label>
                    </div>
                </div>

                <!-- Reset Settings -->
                <div class="pt-4">
                    <button type="button"
                            class="btn btn-ghost btn-sm w-full bg-danger/10 text-danger hover:bg-danger hover:text-white rounded-xl cursor-pointer transition font-semibold"
                            onclick="localStorage.clear(); window.location.reload();">
                        Reset To Default
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
