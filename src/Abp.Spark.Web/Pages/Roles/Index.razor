@page "/roles"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IRoleAppService RoleAppService
@inject IRolePermissionAppService RolePermissionAppService
@inject NavigationManager NavigationManager

<PageTitle>@L["Roles"]</PageTitle>

<section class="space-y-6">
    <!-- Breadcrumb & Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <ul class="flex items-center gap-2 text-xs text-[#888ea8] mb-1 font-semibold">
                <li><a href="/" class="hover:text-primary transition-colors">@L["home"]</a></li>
                <li><span>/</span></li>
                <li><a href="/dashboard" class="hover:text-primary transition-colors">@L["Dashboard"]</a></li>
                <li><span>/</span></li>
                <li class="text-primary font-bold">@L["Roles"]</li>
            </ul>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0e1726] dark:text-white font-nunito flex items-center gap-3">
                <LucideIcon Name="ShieldCheck" Class="w-7 h-7 text-primary" />
                <span>@L["Roles"]</span>
            </h1>
        </div>

        <div class="flex items-center gap-3">
            <button type="button"
                    class="btn btn-primary flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold shadow-sm hover:shadow-md transition cursor-pointer"
                    @onclick="OpenCreateModal">
                <LucideIcon Name="ShieldCheck" Class="w-4 h-4 text-white" />
                <span>新增角色</span>
            </button>
        </div>
    </div>

    <!-- Table Container Card -->
    <div class="card bg-white dark:bg-[#0e1726] rounded-2xl p-6 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
            <div class="relative w-full sm:w-72">
                <input type="text"
                       placeholder="搜索角色名..."
                       class="form-input w-full pl-10 pr-4 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white placeholder-[#888ea8] focus:ring-2 focus:ring-primary/20 outline-none transition"
                       @bind="_filter"
                       @bind:event="oninput" />
                <div class="absolute left-3.5 top-2.5 text-[#888ea8]">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                </div>
            </div>

            <div class="text-xs text-[#888ea8] font-semibold">
                共找到 <span class="text-primary font-bold">@FilteredRoles.Count</span> 个系统角色
            </div>
        </div>

        <!-- Table -->
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-[#506690] dark:text-[#888ea8]">
                <thead>
                    <tr class="border-b border-gray-100 dark:border-[#191e3a] text-[#0e1726] dark:text-white font-extrabold uppercase tracking-wider text-[11px]">
                        <th class="py-3 px-4">角色名称</th>
                        <th class="py-3 px-4">默认角色</th>
                        <th class="py-3 px-4">公开可见</th>
                        <th class="py-3 px-4">角色标识</th>
                        <th class="py-3 px-4 text-right">操作</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-[#191e3a]">
                    @if (_isLoading)
                    {
                        <tr>
                            <td colspan="5" class="py-12 text-center text-sm text-[#888ea8]">
                                正在加载角色与权限数据...
                            </td>
                        </tr>
                    }
                    else if (!FilteredRoles.Any())
                    {
                        <tr>
                            <td colspan="5" class="py-12 text-center text-sm text-[#888ea8]">
                                暂无角色记录
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var role in FilteredRoles)
                        {
                            <tr class="hover:bg-[#f8f9fa] dark:hover:bg-[#121e32]/60 transition-colors">
                                <td class="py-3.5 px-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-primary/10 to-secondary/10 text-primary font-extrabold text-xs flex items-center justify-center shrink-0">
                                            <LucideIcon Name="ShieldCheck" Class="w-4 h-4 text-primary" />
                                        </div>
                                        <div>
                                            <div class="font-bold text-[#0e1726] dark:text-white text-xs">@role.Name</div>
                                            <div class="text-[11px] text-[#888ea8]">并发戳: @(role.ConcurrencyStamp?.Length > 8 ? role.ConcurrencyStamp[..8] + "..." : role.ConcurrencyStamp)</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4">
                                    @if (role.IsDefault)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-success/10 text-success">
                                            是 (Default)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold text-[#888ea8]">
                                            否
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-4">
                                    @if (role.IsPublic)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-primary/10 text-primary">
                                            公开
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold text-[#888ea8]">
                                            受限
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 font-mono text-[11px] text-[#888ea8]">
                                    @role.Id.ToString()[..8]...
                                </td>
                                <td class="py-3.5 px-4 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <!-- 权限配置按钮 -->
                                        <button type="button"
                                                class="px-2.5 py-1 rounded-lg bg-primary/10 text-primary hover:bg-primary hover:text-white transition text-xs font-bold flex items-center gap-1 cursor-pointer"
                                                title="配置权限树"
                                                @onclick="() => OpenPermissionModal(role)">
                                            <LucideIcon Name="Network" Class="w-3.5 h-3.5" />
                                            <span>权限矩阵</span>
                                        </button>
                                        <!-- 删除按钮 -->
                                        <button type="button"
                                                class="w-7 h-7 rounded-lg flex items-center justify-center text-[#888ea8] hover:text-danger hover:bg-danger/10 transition cursor-pointer"
                                                title="删除角色"
                                                @onclick="() => DeleteRoleAsync(role.Id)">
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M3 6h18"/>
                                                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                                <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Create Role Modal -->
    @if (_showCreateModal)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-xs p-4">
            <div class="bg-white dark:bg-[#0e1726] rounded-2xl p-6 w-full max-w-md shadow-xl animate-fade-in">
                <div class="flex items-center justify-between pb-4 border-b border-gray-100 dark:border-[#191e3a]">
                    <h3 class="text-base font-bold text-[#0e1726] dark:text-white">新增系统角色</h3>
                    <button type="button" class="text-[#888ea8] hover:text-danger transition cursor-pointer" @onclick="CloseModal">✕</button>
                </div>
                <div class="space-y-4 py-4">
                    <div>
                        <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">角色名称</label>
                        <input type="text" class="form-input w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white outline-none" @bind="_createRoleName" placeholder="例如：QCInspector, WorkshopSupervisor" />
                    </div>
                    <div class="flex items-center gap-4 pt-2">
                        <label class="flex items-center gap-2 cursor-pointer text-xs font-semibold text-[#0e1726] dark:text-white">
                            <input type="checkbox" class="rounded text-primary" @bind="_createIsDefault" />
                            <span>设为新用户默认角色</span>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer text-xs font-semibold text-[#0e1726] dark:text-white">
                            <input type="checkbox" class="rounded text-primary" @bind="_createIsPublic" />
                            <span>公开可见</span>
                        </label>
                    </div>
                </div>
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100 dark:border-[#191e3a]">
                    <button type="button" class="px-4 py-2 rounded-xl text-xs font-semibold text-[#888ea8] hover:bg-gray-100 dark:hover:bg-[#121e32] transition cursor-pointer" @onclick="CloseModal">取消</button>
                    <button type="button" class="px-4 py-2 rounded-xl text-xs font-bold bg-primary text-white shadow-sm hover:shadow-md transition cursor-pointer" @onclick="CreateRoleAsync">创建角色</button>
                </div>
            </div>
        </div>
    }

    <!-- Permission Matrix Modal -->
    @if (_showPermissionModal && _selectedRole != null)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-xs p-4">
            <div class="bg-white dark:bg-[#0e1726] rounded-2xl p-6 w-full max-w-2xl max-h-[85vh] flex flex-col shadow-xl animate-fade-in">
                <div class="flex items-center justify-between pb-4 border-b border-gray-100 dark:border-[#191e3a]">
                    <div>
                        <h3 class="text-base font-bold text-[#0e1726] dark:text-white flex items-center gap-2">
                            <LucideIcon Name="Network" Class="w-5 h-5 text-primary" />
                            <span>角色权限矩阵授权 - @_selectedRole.Name</span>
                        </h3>
                        <p class="text-xs text-[#888ea8] mt-0.5">勾选赋予该角色的 ABP 领域层细粒度访问权限</p>
                    </div>
                    <button type="button" class="text-[#888ea8] hover:text-danger transition cursor-pointer" @onclick="CloseModal">✕</button>
                </div>

                <!-- Tree View Scroll Area -->
                <div class="flex-1 overflow-y-auto py-4 space-y-4">
                    @if (_isPermissionLoading)
                    {
                        <div class="py-12 text-center text-sm text-[#888ea8]">正在读取权限树...</div>
                    }
                    else if (!_permissionTree.Any())
                    {
                        <div class="py-12 text-center text-sm text-[#888ea8]">未找到权限定义</div>
                    }
                    else
                    {
                        @foreach (var rootNode in _permissionTree)
                        {
                            <div class="p-4 rounded-xl border border-gray-100 dark:border-[#191e3a] bg-[#f9fafb] dark:bg-[#121e32]/30">
                                <div class="flex items-center justify-between mb-2">
                                    <label class="flex items-center gap-2 font-bold text-xs text-[#0e1726] dark:text-white cursor-pointer">
                                        <input type="checkbox"
                                               class="rounded text-primary"
                                               checked="@_grantedPermissions.Contains(rootNode.Key)"
                                               onchange="@(() => TogglePermission(rootNode.Key))" />
                                        <span>@rootNode.Title</span>
                                    </label>
                                    <span class="text-[10px] text-[#888ea8] font-mono">@rootNode.Key</span>
                                </div>

                                @if (rootNode.Children.Any())
                                {
                                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2 mt-2 pt-2 border-t border-gray-200/50 dark:border-[#191e3a]/50 pl-4">
                                        @foreach (var child in rootNode.Children)
                                        {
                                            <label class="flex items-center gap-2 text-xs text-[#506690] dark:text-[#888ea8] hover:text-primary cursor-pointer">
                                                <input type="checkbox"
                                                       class="rounded text-primary"
                                                       checked="@_grantedPermissions.Contains(child.Key)"
                                                       onchange="@(() => TogglePermission(child.Key))" />
                                                <span class="truncate" title="@child.Title">@child.Title</span>
                                            </label>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>

                <div class="flex items-center justify-between pt-4 border-t border-gray-100 dark:border-[#191e3a]">
                    <div class="text-xs text-[#888ea8]">
                        已选中 <span class="font-bold text-primary">@_grantedPermissions.Count</span> 项权限
                    </div>
                    <div class="flex items-center gap-3">
                        <button type="button" class="px-4 py-2 rounded-xl text-xs font-semibold text-[#888ea8] hover:bg-gray-100 dark:hover:bg-[#121e32] transition cursor-pointer" @onclick="CloseModal">取消</button>
                        <button type="button" class="px-4 py-2 rounded-xl text-xs font-bold bg-primary text-white shadow-sm hover:shadow-md transition cursor-pointer" @onclick="SavePermissionsAsync">保存权限授权</button>
                    </div>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private List<IdentityRoleDto> _roles = new();
    private string _filter = string.Empty;
    private bool _isLoading = true;

    private bool _showCreateModal = false;
    private string _createRoleName = string.Empty;
    private bool _createIsDefault = false;
    private bool _createIsPublic = true;

    private bool _showPermissionModal = false;
    private bool _isPermissionLoading = false;
    private IdentityRoleDto? _selectedRole;
    private List<PermissionTreeDto> _permissionTree = new();
    private HashSet<string> _grantedPermissions = new();

    private List<IdentityRoleDto> FilteredRoles => string.IsNullOrWhiteSpace(_filter)
        ? _roles
        : _roles.Where(r => r.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadRolesAsync();
    }

    private async Task LoadRolesAsync()
    {
        _isLoading = true;
        try
        {
            var res = await RoleAppService.AllListAsync();
            _roles = res.Items?.ToList() ?? new();
        }
        catch
        {
            _roles = new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        _createRoleName = string.Empty;
        _createIsDefault = false;
        _createIsPublic = true;
        _showCreateModal = true;
    }

    private async Task CreateRoleAsync()
    {
        if (string.IsNullOrWhiteSpace(_createRoleName)) return;

        try
        {
            await RoleAppService.CreateAsync(new IdentityRoleCreateDto
            {
                Name = _createRoleName,
                IsDefault = _createIsDefault,
                IsPublic = _createIsPublic
            });
            CloseModal();
            await LoadRolesAsync();
        }
        catch
        {
        }
    }

    private async Task DeleteRoleAsync(Guid id)
    {
        try
        {
            await RoleAppService.DeleteAsync(new Lion.AbpPro.Core.IdInput { Id = id });
            await LoadRolesAsync();
        }
        catch
        {
        }
    }

    private async Task OpenPermissionModal(IdentityRoleDto role)
    {
        _selectedRole = role;
        _showPermissionModal = true;
        _isPermissionLoading = true;
        _grantedPermissions.Clear();
        _permissionTree.Clear();

        try
        {
            var res = await RolePermissionAppService.GetPermissionAsync(new GetPermissionInput
            {
                ProviderName = "R",
                ProviderKey = role.Name
            });

            _permissionTree = res.Permissions ?? new();
            _grantedPermissions = new HashSet<string>(res.Grants ?? new());
        }
        catch
        {
        }
        finally
        {
            _isPermissionLoading = false;
        }
    }

    private void TogglePermission(string key)
    {
        if (_grantedPermissions.Contains(key))
        {
            _grantedPermissions.Remove(key);
        }
        else
        {
            _grantedPermissions.Add(key);
        }
    }

    private async Task SavePermissionsAsync()
    {
        if (_selectedRole == null) return;

        try
        {
            var updateDto = new Volo.Abp.PermissionManagement.UpdatePermissionsDto
            {
                Permissions = _grantedPermissions.Select(k => new Volo.Abp.PermissionManagement.UpdatePermissionDto
                {
                    Name = k,
                    IsGranted = true
                }).ToArray()
            };

            await RolePermissionAppService.UpdatePermissionAsync(new UpdateRolePermissionsInput
            {
                ProviderName = "R",
                ProviderKey = _selectedRole.Name,
                UpdatePermissionsDto = updateDto
            });

            CloseModal();
        }
        catch
        {
        }
    }

    private void CloseModal()
    {
        _showCreateModal = false;
        _showPermissionModal = false;
        _selectedRole = null;
    }
}
