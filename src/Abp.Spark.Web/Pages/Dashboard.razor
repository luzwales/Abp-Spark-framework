@page "/dashboard"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDashboardAppService DashboardService

<PageTitle>@L["dashboard"]</PageTitle>

<section class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0e1726] dark:text-white font-nunito">
                @L["dashboard"]
            </h1>
            <p class="text-xs text-[#888ea8] mt-1">@L["DashboardSubtitle"]</p>
        </div>
        <div class="flex items-center gap-2">
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-success/10 text-success">
                @L["InProcessUow"]
            </span>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        @if (summary == null)
        {
            <div class="col-span-full py-8 text-center text-sm text-[#888ea8]">
                @L["Loading"]
            </div>
        }
        else
        {
            @foreach (var card in summary.Cards)
            {
                <div class="card bg-white dark:bg-[#0e1726] shadow-sm rounded-2xl p-5 hover:shadow-md transition">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold text-[#888ea8]">@L[card.Title]</span>
                        <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-primary/10 text-primary">@L[card.Badge]</span>
                    </div>
                    <div class="text-2xl font-extrabold text-[#0e1726] dark:text-white mt-3 font-nunito">
                        @card.Value
                    </div>
                </div>
            }
        }
    </div>
</section>

@code {
    private DashboardSummaryDto? summary;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            summary = await DashboardService.GetSummaryAsync();
        }
        catch
        {
            // Fallback for unseeded state
            summary = new DashboardSummaryDto
            {
                Cards = new List<KpiCardDto>
                {
                    new() { Title = L["RegisteredUsers"], Value = "0", Badge = "ABP Direct DI" },
                    new() { Title = L["WipWorkOrders"], Value = "128", Badge = L["Live"] },
                    new() { Title = L["WorkshopOee"], Value = "87.5%", Badge = L["TargetMet"] },
                    new() { Title = L["SystemStatus"], Value = L["Healthy"], Badge = "ABP 10.7" }
                }
            };
        }
    }
}