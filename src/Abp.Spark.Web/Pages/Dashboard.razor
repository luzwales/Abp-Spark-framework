@page "/dashboard"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDashboardAppService DashboardService

<PageTitle>@L["dashboard"]</PageTitle>

<section class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0e1726] dark:text-white font-nunito">
                @L["dashboard"]
            </h1>
            <p class="text-xs text-[#888ea8] mt-1">ABP vNext DDD 业务层实时聚合数据</p>
        </div>
        <div class="flex items-center gap-2">
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-success/10 text-success">
                ● 直连进程内工作单元
            </span>
        </div>
    </div>

    <!-- KPI 卡片网格 -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        @if (summary == null)
        {
            <div class="col-span-full py-8 text-center text-sm text-[#888ea8]">
                正在从 ABP 领域层加载数据...
            </div>
        }
        else
        {
            @foreach (var card in summary.Cards)
            {
                <div class="card bg-white dark:bg-[#0e1726] shadow-sm rounded-2xl p-5 hover:shadow-md transition">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold text-[#888ea8]">@card.Title</span>
                        <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-primary/10 text-primary">@card.Badge</span>
                    </div>
                    <div class="text-2xl font-extrabold text-[#0e1726] dark:text-white mt-3 font-nunito">
                        @card.Value
                    </div>
                </div>
            }
        }
    </div>
</section>

@code {
    private DashboardSummaryDto? summary;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            summary = await DashboardService.GetSummaryAsync();
        }
        catch
        {
            // Fallback for unseeded state
            summary = new DashboardSummaryDto
            {
                Cards = new List<KpiCardDto>
                {
                    new() { Title = "注册用户总数", Value = "0 人", Badge = "ABP Direct DI" },
                    new() { Title = "制造在制品工单 (WIP)", Value = "128 单", Badge = "实时排产" },
                    new() { Title = "车间综合效率 (OEE)", Value = "87.5%", Badge = "达到目标" },
                    new() { Title = "系统服务状态", Value = "100% 正常", Badge = "ABP 10.7" }
                }
            };
        }
    }
}