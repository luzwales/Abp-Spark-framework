@page "/organization-units"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IOrganizationUnitAppService OuAppService
@inject IRoleAppService RoleAppService
@inject NavigationManager NavigationManager

<PageTitle>@L["OrganizationUnits"]</PageTitle>

<section class="space-y-6">
    <!-- Breadcrumb & Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <ul class="flex items-center gap-2 text-xs text-[#888ea8] mb-1 font-semibold">
                <li><a href="/" class="hover:text-primary transition-colors">@L["home"]</a></li>
                <li><span>/</span></li>
                <li><a href="/dashboard" class="hover:text-primary transition-colors">@L["Dashboard"]</a></li>
                <li><span>/</span></li>
                <li class="text-primary font-bold">@L["OrganizationUnits"]</li>
            </ul>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0e1726] dark:text-white font-nunito flex items-center gap-3">
                <LucideIcon Name="Network" Class="w-7 h-7 text-primary" />
                <span>@L["OrganizationUnits"]</span>
            </h1>
        </div>

        <div class="flex items-center gap-3">
            <button type="button"
                    class="btn btn-primary flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold shadow-sm hover:shadow-md transition cursor-pointer"
                    @onclick="() => OpenCreateModal(null)">
                <LucideIcon Name="Network" Class="w-4 h-4 text-white" />
                <span>新增根部门</span>
            </button>
        </div>
    </div>

    <!-- Main Grid: Left Tree Navigation, Right Detail & Role Management -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Left: Organization Tree -->
        <div class="lg:col-span-5 card bg-white dark:bg-[#0e1726] rounded-2xl p-5 shadow-sm space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-gray-100 dark:border-[#191e3a]">
                <h3 class="text-xs font-extrabold uppercase tracking-wider text-[#0e1726] dark:text-white">组织架构树</h3>
                <span class="text-[11px] text-[#888ea8]">共 @_allOusCount 个部门</span>
            </div>

            @if (_isLoading)
            {
                <div class="py-12 text-center text-xs text-[#888ea8]">正在读取组织架构树...</div>
            }
            else if (!_ouTree.Any())
            {
                <div class="py-12 text-center text-xs text-[#888ea8]">暂无部门数据</div>
            }
            else
            {
                <div class="space-y-1">
                    @foreach (var node in _ouTree)
                    {
                        @RenderTreeNode(node, 0)
                    }
                </div>
            }
        </div>

        <!-- Right: Selected OU Details & Role Assignment Operations -->
        <div class="lg:col-span-7 space-y-6">
            @if (_selectedOu == null)
            {
                <div class="card bg-white dark:bg-[#0e1726] rounded-2xl p-12 text-center shadow-sm">
                    <LucideIcon Name="Network" Class="w-12 h-12 mx-auto text-[#888ea8] opacity-40 mb-3" />
                    <p class="text-xs font-semibold text-[#888ea8]">请在左侧选择一个组织机构以查看详情并配置角色</p>
                </div>
            }
            else
            {
                <!-- Selected OU Info Card -->
                <div class="card bg-white dark:bg-[#0e1726] rounded-2xl p-6 shadow-sm space-y-6">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-gray-100 dark:border-[#191e3a]">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-mono text-xs px-2 py-0.5 rounded bg-primary/10 text-primary font-bold">@_selectedOu.Code</span>
                                <h2 class="text-lg font-bold text-[#0e1726] dark:text-white">@_selectedOu.DisplayName</h2>
                            </div>
                            <div class="text-xs text-[#888ea8] mt-1 flex items-center gap-4">
                                <span>主管: <strong class="text-[#0e1726] dark:text-white">@(_selectedOu.ManagerName ?? "未指定")</strong></span>
                                <span>级别: <strong class="text-primary font-bold">L@(_selectedOu.ManagerLevel ?? 1)</strong></span>
                            </div>
                        </div>

                        <div class="flex items-center gap-2">
                            <button type="button"
                                    class="px-3 py-1.5 rounded-xl bg-gray-100 dark:bg-[#121e32] text-xs font-bold text-[#0e1726] dark:text-white hover:text-primary transition cursor-pointer"
                                    @onclick="() => OpenCreateModal(_selectedOu.Id)">
                                + 子部门
                            </button>
                            <button type="button"
                                    class="px-3 py-1.5 rounded-xl bg-primary text-white text-xs font-bold shadow-sm hover:shadow-md transition cursor-pointer"
                                    @onclick="OpenAssignRoleModal">
                                角色授权分发
                            </button>
                            <button type="button"
                                    class="p-2 rounded-xl text-[#888ea8] hover:text-danger hover:bg-danger/10 transition cursor-pointer"
                                    title="删除此部门"
                                    @onclick="() => DeleteOuAsync(_selectedOu.Id)">
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 6h18"/>
                                    <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                    <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <!-- Role Assignment Cards Section -->
                    <div class="space-y-4">
                        <div class="flex items-center justify-between">
                            <h4 class="text-xs font-extrabold uppercase tracking-wider text-[#0e1726] dark:text-white">
                                当前部门直属角色 (@_ouRoles.Count)
                            </h4>
                        </div>

                        @if (!_ouRoles.Any())
                        {
                            <div class="p-6 rounded-xl border border-dashed border-gray-200 dark:border-[#191e3a] text-center text-xs text-[#888ea8]">
                                当前部门尚未直接绑定任何角色，点击上方「角色授权分发」进行设定。
                            </div>
                        }
                        else
                        {
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                @foreach (var role in _ouRoles)
                                {
                                    <div class="p-3.5 rounded-xl bg-[#f8f9fa] dark:bg-[#121e32] flex items-center justify-between">
                                        <div class="flex items-center gap-2.5">
                                            <div class="w-7 h-7 rounded-lg bg-primary/10 text-primary flex items-center justify-center">
                                                <LucideIcon Name="ShieldCheck" Class="w-3.5 h-3.5 text-primary" />
                                            </div>
                                            <div>
                                                <div class="text-xs font-bold text-[#0e1726] dark:text-white">@role.Name</div>
                                                <div class="text-[10px] text-[#888ea8]">已生效于本部门成员</div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <!-- Quick Role Distribution Action Tiles -->
                        <div class="pt-4 border-t border-gray-100 dark:border-[#191e3a]">
                            <h4 class="text-xs font-extrabold uppercase tracking-wider text-[#888ea8] mb-3">
                                快捷授权策略 (参照 FlexQuality 扩展规范)
                            </h4>
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                                <div class="p-3.5 rounded-xl border border-gray-100 dark:border-[#191e3a] bg-white dark:bg-[#0e1726] hover:border-primary/50 transition">
                                    <div class="text-xs font-bold text-[#0e1726] dark:text-white mb-1">子部门级联分配</div>
                                    <p class="text-[11px] text-[#888ea8] leading-relaxed">向当前部门及其全部下级子孙部门同步赋予选定角色。</p>
                                </div>
                                <div class="p-3.5 rounded-xl border border-gray-100 dark:border-[#191e3a] bg-white dark:bg-[#0e1726] hover:border-primary/50 transition">
                                    <div class="text-xs font-bold text-[#0e1726] dark:text-white mb-1">部门主管经理授权</div>
                                    <p class="text-[11px] text-[#888ea8] leading-relaxed">直接将角色赋予当前部门主管 (@(_selectedOu.ManagerName ?? "未指定"))。</p>
                                </div>
                                <div class="p-3.5 rounded-xl border border-gray-100 dark:border-[#191e3a] bg-white dark:bg-[#0e1726] hover:border-primary/50 transition">
                                    <div class="text-xs font-bold text-[#0e1726] dark:text-white mb-1">所有子部门主管授权</div>
                                    <p class="text-[11px] text-[#888ea8] leading-relaxed">批量扫描下属各子部门，向所有子部门主管授予角色。</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Create OU Modal -->
    @if (_showCreateModal)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-xs p-4">
            <div class="bg-white dark:bg-[#0e1726] rounded-2xl p-6 w-full max-w-md shadow-xl animate-fade-in">
                <div class="flex items-center justify-between pb-4 border-b border-gray-100 dark:border-[#191e3a]">
                    <h3 class="text-base font-bold text-[#0e1726] dark:text-white">
                        @(_createParentId.HasValue ? "新增子组织机构" : "新增根组织机构")
                    </h3>
                    <button type="button" class="text-[#888ea8] hover:text-danger transition cursor-pointer" @onclick="CloseModal">✕</button>
                </div>
                <div class="space-y-4 py-4">
                    <div>
                        <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">部门名称</label>
                        <input type="text" class="form-input w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white outline-none" @bind="_createDisplayName" placeholder="例如：精密加工一车间" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">部门负责人 (Manager)</label>
                        <select class="form-select w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white outline-none" @bind="_createManagerId">
                            <option value="">(暂不指定主管)</option>
                            @foreach (var user in _allUsers)
                            {
                                <option value="@user.Id">@user.Name (@user.Email)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">主管层级 (Level)</label>
                        <select class="form-select w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white outline-none" @bind="_createManagerLevel">
                            <option value="1">Level 1 - 部门一级主管 (Department Head)</option>
                            <option value="2">Level 2 - 车间/组室主管 (Supervisor)</option>
                            <option value="3">Level 3 - 产线班组长 (Team Leader)</option>
                        </select>
                    </div>
                </div>
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100 dark:border-[#191e3a]">
                    <button type="button" class="px-4 py-2 rounded-xl text-xs font-semibold text-[#888ea8] hover:bg-gray-100 dark:hover:bg-[#121e32] transition cursor-pointer" @onclick="CloseModal">取消</button>
                    <button type="button" class="px-4 py-2 rounded-xl text-xs font-bold bg-primary text-white shadow-sm hover:shadow-md transition cursor-pointer" @onclick="CreateOuAsync">保存创建</button>
                </div>
            </div>
        </div>
    }

    <!-- Advanced Role Assignment Modal -->
    @if (_showAssignRoleModal && _selectedOu != null)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-xs p-4">
            <div class="bg-white dark:bg-[#0e1726] rounded-2xl p-6 w-full max-w-lg shadow-xl animate-fade-in">
                <div class="flex items-center justify-between pb-4 border-b border-gray-100 dark:border-[#191e3a]">
                    <div>
                        <h3 class="text-base font-bold text-[#0e1726] dark:text-white flex items-center gap-2">
                            <LucideIcon Name="ShieldCheck" Class="w-5 h-5 text-primary" />
                            <span>角色授权分发 - @_selectedOu.DisplayName</span>
                        </h3>
                        <p class="text-xs text-[#888ea8] mt-0.5">选择授权目标与角色，系统将根据策略执行批量授予</p>
                    </div>
                    <button type="button" class="text-[#888ea8] hover:text-danger transition cursor-pointer" @onclick="CloseModal">✕</button>
                </div>

                <div class="space-y-4 py-4">
                    <!-- Target Strategy Choice -->
                    <div>
                        <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-2">授权目标策略</label>
                        <div class="space-y-2">
                            <label class="flex items-center gap-2.5 p-2.5 rounded-xl border border-gray-100 dark:border-[#191e3a] cursor-pointer hover:bg-gray-50 dark:hover:bg-[#121e32]">
                                <input type="radio" name="assignMode" value="CurrentOu" checked="@(_assignMode == "CurrentOu")" @onchange="@(() => _assignMode = "CurrentOu")" class="text-primary" />
                                <div>
                                    <div class="text-xs font-bold text-[#0e1726] dark:text-white">仅赋予当前部门 (OU Role)</div>
                                    <div class="text-[11px] text-[#888ea8]">为本组织单元直接分配角色</div>
                                </div>
                            </label>
                            <label class="flex items-center gap-2.5 p-2.5 rounded-xl border border-gray-100 dark:border-[#191e3a] cursor-pointer hover:bg-gray-50 dark:hover:bg-[#121e32]">
                                <input type="radio" name="assignMode" value="ChildrenOu" checked="@(_assignMode == "ChildrenOu")" @onchange="@(() => _assignMode = "ChildrenOu")" class="text-primary" />
                                <div>
                                    <div class="text-xs font-bold text-[#0e1726] dark:text-white">级联赋予本部门及所有子部门 (Children OU Roles)</div>
                                    <div class="text-[11px] text-[#888ea8]">下属所有车间、科室同步获得该角色</div>
                                </div>
                            </label>
                            <label class="flex items-center gap-2.5 p-2.5 rounded-xl border border-gray-100 dark:border-[#191e3a] cursor-pointer hover:bg-gray-50 dark:hover:bg-[#121e32]">
                                <input type="radio" name="assignMode" value="Manager" checked="@(_assignMode == "Manager")" @onchange="@(() => _assignMode = "Manager")" class="text-primary" />
                                <div>
                                    <div class="text-xs font-bold text-[#0e1726] dark:text-white">仅赋予当前部门主管经理 (Manager Role)</div>
                                    <div class="text-[11px] text-[#888ea8]">自动赋予负责人: @(_selectedOu.ManagerName ?? "未指定")</div>
                                </div>
                            </label>
                            <label class="flex items-center gap-2.5 p-2.5 rounded-xl border border-gray-100 dark:border-[#191e3a] cursor-pointer hover:bg-gray-50 dark:hover:bg-[#121e32]">
                                <input type="radio" name="assignMode" value="ChildrenManagers" checked="@(_assignMode == "ChildrenManagers")" @onchange="@(() => _assignMode = "ChildrenManagers")" class="text-primary" />
                                <div>
                                    <div class="text-xs font-bold text-[#0e1726] dark:text-white">级联批量赋予所有子部门主管经理 (Children Managers)</div>
                                    <div class="text-[11px] text-[#888ea8]">自动遍历并赋权下属所有车间/班组的负责人账号</div>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Roles Multi-select Checkboxes -->
                    <div>
                        <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-2">选择赋予的角色</label>
                        <div class="max-h-48 overflow-y-auto space-y-1.5 p-2 rounded-xl bg-[#f6f8fa] dark:bg-[#121e32]">
                            @if (!_allRoles.Any())
                            {
                                <div class="py-4 text-center text-xs text-[#888ea8]">暂无可选角色</div>
                            }
                            else
                            {
                                @foreach (var r in _allRoles)
                                {
                                    <label class="flex items-center gap-2 text-xs text-[#0e1726] dark:text-white p-1 hover:text-primary cursor-pointer">
                                        <input type="checkbox"
                                               class="rounded text-primary"
                                               checked="@_selectedRoleIds.Contains(r.Id)"
                                               onchange="@(() => ToggleSelectedRole(r.Id))" />
                                        <span>@r.Name</span>
                                    </label>
                                }
                            }
                        </div>
                    </div>
                </div>

                <div class="flex items-center justify-between pt-4 border-t border-gray-100 dark:border-[#191e3a]">
                    <div class="text-xs text-[#888ea8]">
                        已选 <span class="font-bold text-primary">@_selectedRoleIds.Count</span> 个角色
                    </div>
                    <div class="flex items-center gap-3">
                        <button type="button" class="px-4 py-2 rounded-xl text-xs font-semibold text-[#888ea8] hover:bg-gray-100 dark:hover:bg-[#121e32] transition cursor-pointer" @onclick="CloseModal">取消</button>
                        <button type="button" class="px-4 py-2 rounded-xl text-xs font-bold bg-primary text-white shadow-sm hover:shadow-md transition cursor-pointer" @onclick="ExecuteRoleAssignmentAsync">执行授权分发</button>
                    </div>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private List<OrganizationUnitTreeDto> _ouTree = new();
    private List<IdentityRoleDto> _allRoles = new();
    private List<UserDto> _allUsers = new();
    private int _allOusCount = 0;
    private bool _isLoading = true;

    private OrganizationUnitTreeDto? _selectedOu;
    private List<IdentityRoleDto> _ouRoles = new();
    private readonly HashSet<Guid> _expandedNodeIds = new();

    private bool _showCreateModal = false;
    private Guid? _createParentId;
    private string _createDisplayName = string.Empty;
    private Guid? _createManagerId;
    private int _createManagerLevel = 1;

    private bool _showAssignRoleModal = false;
    private string _assignMode = "CurrentOu";
    private readonly HashSet<Guid> _selectedRoleIds = new();

    [Inject] public IUserAppService UserAppService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllDataAsync();
    }

    private async Task LoadAllDataAsync()
    {
        _isLoading = true;
        try
        {
            _ouTree = await OuAppService.GetTreeAsync();
            _allOusCount = CountTreeNodes(_ouTree);

            // 默认展开所有一级节点
            foreach (var node in _ouTree)
            {
                _expandedNodeIds.Add(node.Id);
            }

            if (_ouTree.Any() && _selectedOu == null)
            {
                await SelectOuAsync(_ouTree.First());
            }

            var rolesResult = await RoleAppService.AllListAsync();
            _allRoles = rolesResult.Items?.ToList() ?? new();

            _allUsers = await UserAppService.GetListAsync();
        }
        catch
        {
            _ouTree = new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SelectOuAsync(OrganizationUnitTreeDto ou)
    {
        _selectedOu = ou;
        try
        {
            _ouRoles = await OuAppService.GetRolesAsync(ou.Id);
        }
        catch
        {
            _ouRoles = new();
        }
    }

    private void ToggleExpand(Guid id)
    {
        if (_expandedNodeIds.Contains(id))
            _expandedNodeIds.Remove(id);
        else
            _expandedNodeIds.Add(id);
    }

    private RenderFragment RenderTreeNode(OrganizationUnitTreeDto node, int level) => __builder =>
    {
        var isSelected = _selectedOu?.Id == node.Id;
        var hasChildren = node.Children.Any();
        var isExpanded = _expandedNodeIds.Contains(node.Id);

        <div class="space-y-1">
            <div class="flex items-center justify-between p-2 rounded-xl transition-colors @(isSelected ? "bg-primary/10 text-primary font-bold" : "hover:bg-[#f6f8fa] dark:hover:bg-[#121e32] text-[#0e1726] dark:text-white")"
                 style="padding-left: @(level * 16 + 8)px;">
                <div class="flex items-center gap-2 truncate cursor-pointer flex-1" @onclick="() => SelectOuAsync(node)">
                    @if (hasChildren)
                    {
                        <button type="button" class="w-4 h-4 flex items-center justify-center text-[#888ea8] hover:text-primary" @onclick="() => ToggleExpand(node.Id)" onclick:stopPropagation="true">
                            <LucideIcon Name="@(isExpanded ? "ChevronDown" : "ChevronRight")" Class="w-3.5 h-3.5" />
                        </button>
                    }
                    else
                    {
                        <span class="w-4 h-4"></span>
                    }

                    <LucideIcon Name="Network" Class="w-4 h-4 shrink-0 text-primary" />
                    <span class="text-xs truncate">@node.DisplayName</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(node.ManagerName))
                {
                    <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-gray-100 dark:bg-[#191e3a] text-[#888ea8] shrink-0 font-normal">
                        @node.ManagerName
                    </span>
                }
            </div>

            @if (hasChildren && isExpanded)
            {
                <div class="space-y-1">
                    @foreach (var child in node.Children)
                    {
                        @RenderTreeNode(child, level + 1)
                    }
                </div>
            }
        </div>
    };

    private void OpenCreateModal(Guid? parentId)
    {
        _createParentId = parentId;
        _createDisplayName = string.Empty;
        _createManagerId = null;
        _createManagerLevel = 1;
        _showCreateModal = true;
    }

    private async Task CreateOuAsync()
    {
        if (string.IsNullOrWhiteSpace(_createDisplayName)) return;

        try
        {
            await OuAppService.CreateAsync(new CreateOrganizationUnitInput
            {
                DisplayName = _createDisplayName,
                ParentId = _createParentId,
                ManagerId = _createManagerId,
                ManagerLevel = _createManagerLevel
            });

            CloseModal();
            await LoadAllDataAsync();
        }
        catch
        {
        }
    }

    private async Task DeleteOuAsync(Guid id)
    {
        try
        {
            await OuAppService.DeleteAsync(id);
            _selectedOu = null;
            await LoadAllDataAsync();
        }
        catch
        {
        }
    }

    private void OpenAssignRoleModal()
    {
        _selectedRoleIds.Clear();
        _assignMode = "CurrentOu";
        _showAssignRoleModal = true;
    }

    private void ToggleSelectedRole(Guid roleId)
    {
        if (_selectedRoleIds.Contains(roleId))
            _selectedRoleIds.Remove(roleId);
        else
            _selectedRoleIds.Add(roleId);
    }

    private async Task ExecuteRoleAssignmentAsync()
    {
        if (_selectedOu == null || !_selectedRoleIds.Any()) return;

        try
        {
            var roleIds = _selectedRoleIds.ToList();
            var ouIds = new List<Guid> { _selectedOu.Id };

            switch (_assignMode)
            {
                case "CurrentOu":
                    await OuAppService.AddRoleToOrganizationUnitAsync(new AddRoleToOrganizationUnitInput
                    {
                        OrganizationUnitId = _selectedOu.Id,
                        RoleIds = roleIds
                    });
                    break;

                case "ChildrenOu":
                    await OuAppService.AddRoleToChildrenOrganizationUnitAsync(new AddRoleToChildrenOrganizationUnitInput
                    {
                        OrganizationUnitIds = ouIds,
                        RoleIds = roleIds
                    });
                    break;

                case "Manager":
                    await OuAppService.AddRoleToManagerAsync(new AddRoleToManagerInput
                    {
                        OrganizationUnitIds = ouIds,
                        RoleIds = roleIds
                    });
                    break;

                case "ChildrenManagers":
                    await OuAppService.AddRoleToChildrenManagersAsync(new AddRoleToChildrenManagersInput
                    {
                        OrganizationUnitIds = ouIds,
                        RoleIds = roleIds
                    });
                    break;
            }

            CloseModal();
            if (_selectedOu != null)
            {
                await SelectOuAsync(_selectedOu);
            }
        }
        catch
        {
        }
    }

    private void CloseModal()
    {
        _showCreateModal = false;
        _showAssignRoleModal = false;
    }

    private static int CountTreeNodes(List<OrganizationUnitTreeDto> nodes)
    {
        return nodes.Sum(n => 1 + CountTreeNodes(n.Children));
    }
}
