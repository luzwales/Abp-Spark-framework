@page "/users"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IUserAppService UserAppService
@inject NavigationManager NavigationManager

<PageTitle>@L["Users"]</PageTitle>

<section class="space-y-6">
    <!-- Breadcrumb & Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <ul class="flex items-center gap-2 text-xs text-[#888ea8] mb-1 font-semibold">
                <li><a href="/" class="hover:text-primary transition-colors">@L["home"]</a></li>
                <li><span>/</span></li>
                <li><a href="/dashboard" class="hover:text-primary transition-colors">@L["Dashboard"]</a></li>
                <li><span>/</span></li>
                <li class="text-primary font-bold">@L["Users"]</li>
            </ul>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0e1726] dark:text-white font-nunito flex items-center gap-3">
                <LucideIcon Name="Users" Class="w-7 h-7 text-primary" />
                <span>@L["Users"]</span>
            </h1>
        </div>

        <div class="flex items-center gap-3">
            <button type="button"
                    class="btn btn-primary flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold shadow-sm hover:shadow-md transition cursor-pointer"
                    @onclick="OpenCreateModal">
                <LucideIcon Name="Users" Class="w-4 h-4 text-white" />
                <span>新增用户</span>
            </button>
        </div>
    </div>

    <!-- Table Card Container (Borderless, Soft Shadow, Vristo Aesthetic) -->
    <div class="card bg-white dark:bg-[#0e1726] rounded-2xl p-6 shadow-sm">
        <!-- Search & Filter Bar -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
            <div class="relative w-full sm:w-72">
                <input type="text"
                       placeholder="搜索姓名或邮箱..."
                       class="form-input w-full pl-10 pr-4 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white placeholder-[#888ea8] focus:ring-2 focus:ring-primary/20 outline-none transition"
                       @bind="_searchTerm"
                       @bind:event="oninput" />
                <div class="absolute left-3.5 top-2.5 text-[#888ea8]">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                </div>
            </div>

            <div class="text-xs text-[#888ea8] font-semibold">
                共找到 <span class="text-primary font-bold">@FilteredUsers.Count</span> 位用户
            </div>
        </div>

        <!-- Data Grid Table -->
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-[#506690] dark:text-[#888ea8]">
                <thead>
                    <tr class="border-b border-gray-100 dark:border-[#191e3a] text-[#0e1726] dark:text-white font-extrabold uppercase tracking-wider text-[11px]">
                        <th class="py-3 px-4">用户信息</th>
                        <th class="py-3 px-4">邮箱</th>
                        <th class="py-3 px-4">角色</th>
                        <th class="py-3 px-4">账号状态</th>
                        <th class="py-3 px-4 text-right">操作</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-[#191e3a]">
                    @if (_isLoading)
                    {
                        <tr>
                            <td colspan="5" class="py-12 text-center text-sm text-[#888ea8]">
                                正在加载用户数据...
                            </td>
                        </tr>
                    }
                    else if (!FilteredUsers.Any())
                    {
                        <tr>
                            <td colspan="5" class="py-12 text-center text-sm text-[#888ea8]">
                                暂无匹配的用户记录
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in FilteredUsers)
                        {
                            <tr class="hover:bg-[#f8f9fa] dark:hover:bg-[#121e32]/60 transition-colors">
                                <td class="py-3.5 px-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-primary/20 to-secondary/20 text-primary font-extrabold text-xs flex items-center justify-center shrink-0">
                                            @(string.IsNullOrWhiteSpace(user.Name) ? "U" : user.Name[0].ToString().ToUpper())
                                        </div>
                                        <div>
                                            <div class="font-bold text-[#0e1726] dark:text-white text-xs">@user.Name</div>
                                            <div class="text-[11px] text-[#888ea8]">ID: @user.Id.ToString()[..8]...</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4 font-medium">@user.Email</td>
                                <td class="py-3.5 px-4">
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-bold bg-danger/10 text-danger">
                                            Admin
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-bold bg-primary/10 text-primary">
                                            @user.Role
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-4">
                                    @if (user.IsActive)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-success/10 text-success">
                                            <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
                                            正常
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-gray-100 text-[#888ea8]">
                                            <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>
                                            已禁用
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <button type="button"
                                                class="w-7 h-7 rounded-lg flex items-center justify-center text-[#888ea8] hover:text-primary hover:bg-primary/10 transition cursor-pointer"
                                                title="编辑用户"
                                                @onclick="() => OpenEditModal(user)">
                                            <LucideIcon Name="Settings" Class="w-3.5 h-3.5" />
                                        </button>
                                        <button type="button"
                                                class="w-7 h-7 rounded-lg flex items-center justify-center text-[#888ea8] hover:text-danger hover:bg-danger/10 transition cursor-pointer"
                                                title="删除用户"
                                                @onclick="() => DeleteUserAsync(user.Id)">
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M3 6h18"/>
                                                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                                <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Create User Modal -->
    @if (_showCreateModal)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-xs p-4">
            <div class="bg-white dark:bg-[#0e1726] rounded-2xl p-6 w-full max-w-md shadow-xl animate-fade-in">
                <div class="flex items-center justify-between pb-4 border-b border-gray-100 dark:border-[#191e3a]">
                    <h3 class="text-base font-bold text-[#0e1726] dark:text-white">新增用户</h3>
                    <button type="button" class="text-[#888ea8] hover:text-danger transition cursor-pointer" @onclick="CloseModal">
                        ✕
                    </button>
                </div>
                <div class="space-y-4 py-4">
                    <div>
                        <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">姓名</label>
                        <input type="text" class="form-input w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white outline-none" @bind="_createModel.Name" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">电子邮箱</label>
                        <input type="email" class="form-input w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white outline-none" @bind="_createModel.Email" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">登录密码</label>
                        <input type="password" class="form-input w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white outline-none" @bind="_createModel.Password" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">角色</label>
                        <select class="form-select w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white outline-none" @bind="_createModel.Role">
                            <option value="User">普通用户 (User)</option>
                            <option value="Admin">系统管理员 (Admin)</option>
                            <option value="Manager">车间主管 (Manager)</option>
                        </select>
                    </div>
                </div>
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100 dark:border-[#191e3a]">
                    <button type="button" class="px-4 py-2 rounded-xl text-xs font-semibold text-[#888ea8] hover:bg-gray-100 dark:hover:bg-[#121e32] transition cursor-pointer" @onclick="CloseModal">取消</button>
                    <button type="button" class="px-4 py-2 rounded-xl text-xs font-bold bg-primary text-white shadow-sm hover:shadow-md transition cursor-pointer" @onclick="CreateUserAsync">确认保存</button>
                </div>
            </div>
        </div>
    }

    <!-- Edit User Modal -->
    @if (_showEditModal && _editingUser != null)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-xs p-4">
            <div class="bg-white dark:bg-[#0e1726] rounded-2xl p-6 w-full max-w-md shadow-xl animate-fade-in">
                <div class="flex items-center justify-between pb-4 border-b border-gray-100 dark:border-[#191e3a]">
                    <h3 class="text-base font-bold text-[#0e1726] dark:text-white">编辑用户 - @_editingUser.Name</h3>
                    <button type="button" class="text-[#888ea8] hover:text-danger transition cursor-pointer" @onclick="CloseModal">
                        ✕
                    </button>
                </div>
                <div class="space-y-4 py-4">
                    <div>
                        <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">姓名</label>
                        <input type="text" class="form-input w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white outline-none" @bind="_updateModel.Name" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">重置密码 (留空则不修改)</label>
                        <input type="password" placeholder="若无需重置密码请留空" class="form-input w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white outline-none" @bind="_updateModel.Password" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">角色</label>
                        <select class="form-select w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white outline-none" @bind="_updateModel.Role">
                            <option value="User">普通用户 (User)</option>
                            <option value="Admin">系统管理员 (Admin)</option>
                            <option value="Manager">车间主管 (Manager)</option>
                        </select>
                    </div>
                    <div class="flex items-center gap-2 pt-2">
                        <input type="checkbox" id="isActiveCheck" class="rounded text-primary focus:ring-0 cursor-pointer" @bind="_updateModel.IsActive" />
                        <label for="isActiveCheck" class="text-xs font-bold text-[#0e1726] dark:text-white cursor-pointer">账号启用状态</label>
                    </div>
                </div>
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100 dark:border-[#191e3a]">
                    <button type="button" class="px-4 py-2 rounded-xl text-xs font-semibold text-[#888ea8] hover:bg-gray-100 dark:hover:bg-[#121e32] transition cursor-pointer" @onclick="CloseModal">取消</button>
                    <button type="button" class="px-4 py-2 rounded-xl text-xs font-bold bg-primary text-white shadow-sm hover:shadow-md transition cursor-pointer" @onclick="SaveEditUserAsync">保存修改</button>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private List<UserDto> _users = new();
    private string _searchTerm = string.Empty;
    private bool _isLoading = true;

    private bool _showCreateModal = false;
    private bool _showEditModal = false;
    private UserDto? _editingUser;

    private CreateUserDto _createModel = new();
    private UpdateUserDto _updateModel = new();

    private List<UserDto> FilteredUsers => string.IsNullOrWhiteSpace(_searchTerm)
        ? _users
        : _users.Where(u => u.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                            u.Email.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        _isLoading = true;
        try
        {
            _users = await UserAppService.GetListAsync();
        }
        catch
        {
            _users = new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        _createModel = new CreateUserDto();
        _showCreateModal = true;
    }

    private void OpenEditModal(UserDto user)
    {
        _editingUser = user;
        _updateModel = new UpdateUserDto
        {
            Name = user.Name,
            Role = user.Role,
            IsActive = user.IsActive
        };
        _showEditModal = true;
    }

    private void CloseModal()
    {
        _showCreateModal = false;
        _showEditModal = false;
        _editingUser = null;
    }

    private async Task CreateUserAsync()
    {
        if (string.IsNullOrWhiteSpace(_createModel.Name) || string.IsNullOrWhiteSpace(_createModel.Email) || string.IsNullOrWhiteSpace(_createModel.Password))
        {
            return;
        }

        try
        {
            await UserAppService.CreateAsync(_createModel);
            CloseModal();
            await LoadUsersAsync();
        }
        catch
        {
            // 异常在生产由全局处理
        }
    }

    private async Task SaveEditUserAsync()
    {
        if (_editingUser == null || string.IsNullOrWhiteSpace(_updateModel.Name)) return;

        try
        {
            await UserAppService.UpdateAsync(_editingUser.Id, _updateModel);
            CloseModal();
            await LoadUsersAsync();
        }
        catch
        {
        }
    }

    private async Task DeleteUserAsync(Guid id)
    {
        try
        {
            await UserAppService.DeleteAsync(id);
            await LoadUsersAsync();
        }
        catch
        {
        }
    }
}
