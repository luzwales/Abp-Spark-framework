@page "/users"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IUserAppService UserAppService
@inject NavigationManager NavigationManager

<PageTitle>@L["Users"]</PageTitle>

<section class="space-y-6">
    <!-- Breadcrumb & Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <ul class="flex items-center gap-2 text-xs text-[#888ea8] mb-1 font-semibold">
                <li><a href="/" class="hover:text-primary transition-colors">@L["home"]</a></li>
                <li><span>/</span></li>
                <li><a href="/dashboard" class="hover:text-primary transition-colors">@L["Dashboard"]</a></li>
                <li><span>/</span></li>
                <li class="text-primary font-bold">@L["Users"]</li>
            </ul>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0e1726] dark:text-white font-nunito flex items-center gap-3">
                <LucideIcon Name="Users" Class="w-7 h-7 text-primary" />
                <span>@L["Users"]</span>
            </h1>
        </div>

        <div class="flex items-center gap-3">
            <button type="button"
                    class="btn btn-primary w-9 h-9 p-0 rounded-xl flex items-center justify-center shadow-sm hover:shadow-md transition cursor-pointer"
                    title="@L["Create"]"
                    @onclick="OpenCreateModal">
                <LucideIcon Name="Plus" Class="w-5 h-5 text-white" />
            </button>
        </div>
    </div>

    <!-- Table Card Container (Borderless, Soft Shadow, Vristo Aesthetic) -->
    <div class="card bg-white dark:bg-[#0e1726] rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-[#1b2e4b]">
        <!-- Search & Filter Bar -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
            <div class="relative w-full sm:w-72">
                <input type="text"
                       placeholder="@L["search_placeholder"]"
                       class="form-input w-full pl-10 pr-4 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white placeholder-[#888ea8] focus:ring-2 focus:ring-primary/20 outline-none transition"
                       @bind="_searchTerm"
                       @bind:event="oninput" />
                <div class="absolute left-3.5 top-2.5 text-[#888ea8]">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                </div>
            </div>

            <div class="text-xs text-[#888ea8] font-semibold">
                @L["Total"]: <span class="text-primary font-bold font-mono">@FilteredUsers.Count</span>
            </div>
        </div>

        <!-- Data Grid Table -->
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-[#506690] dark:text-[#888ea8]">
                <thead>
                    <tr class="border-b border-gray-100 dark:border-[#191e3a] text-[#0e1726] dark:text-white font-extrabold uppercase tracking-wider text-[11px]">
                        <th class="py-3 px-4">@L["UserInfo"]</th>
                        <th class="py-3 px-4">@L["Email"]</th>
                        <th class="py-3 px-4">@L["Roles"]</th>
                        <th class="py-3 px-4">@L["Status"]</th>
                        <th class="py-3 px-4 text-right">@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-[#191e3a]">
                    @if (_isLoading)
                    {
                        <tr>
                            <td colspan="5" class="py-12 text-center text-sm text-[#888ea8]">
                                正在加载用户数据...
                            </td>
                        </tr>
                    }
                    else if (!FilteredUsers.Any())
                    {
                        <tr>
                            <td colspan="5" class="py-12 text-center text-sm text-[#888ea8]">
                                暂无匹配的用户记录
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in FilteredUsers)
                        {
                            <tr class="hover:bg-[#f8f9fa] dark:hover:bg-[#121e32]/60 transition-colors">
                                <td class="py-3.5 px-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-primary/20 to-secondary/20 text-primary font-extrabold text-xs flex items-center justify-center shrink-0">
                                            @(string.IsNullOrWhiteSpace(user.Name) ? "U" : user.Name[0].ToString().ToUpper())
                                        </div>
                                        <div>
                                            <div class="font-bold text-[#0e1726] dark:text-white text-xs">@user.Name</div>
                                            <div class="text-[11px] text-[#888ea8]">ID: @user.Id.ToString()[..8]...</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4 font-medium">@user.Email</td>
                                <td class="py-3.5 px-4">
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-bold bg-danger/10 text-danger">
                                            Admin
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-bold bg-primary/10 text-primary">
                                            @user.Role
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-4">
                                    @if (user.IsActive)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-success/10 text-success">
                                            <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
                                            @L["Active"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-gray-100 text-[#888ea8]">
                                            <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>
                                            @L["Disabled"]
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-right">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <!-- View / Edit 纯 Eye 图标 -->
                                        <button type="button"
                                                class="w-7 h-7 rounded-lg flex items-center justify-center text-[#888ea8] hover:text-primary hover:bg-primary/10 transition cursor-pointer"
                                                title="@L["Edit"]"
                                                @onclick="() => OpenEditModal(user)">
                                            <LucideIcon Name="Eye" Class="w-3.5 h-3.5" />
                                        </button>
                                        <!-- 删除 纯 Trash2 图标 -->
                                        <button type="button"
                                                class="w-7 h-7 rounded-lg flex items-center justify-center text-[#888ea8] hover:text-danger hover:bg-danger/10 transition cursor-pointer"
                                                title="@L["Delete"]"
                                                @onclick="() => DeleteUserAsync(user.Id)">
                                            <LucideIcon Name="Trash2" Class="w-3.5 h-3.5" />
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Create User Modal -->
    @if (_showCreateModal)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-xs p-4">
            <div class="bg-white dark:bg-[#0e1726] rounded-2xl p-6 w-full max-w-md shadow-xl animate-fade-in border border-gray-100 dark:border-[#1b2e4b]">
                <div class="flex items-center justify-between pb-4 border-b border-gray-100 dark:border-[#191e3a]">
                    <h3 class="text-base font-bold text-[#0e1726] dark:text-white flex items-center gap-2">
                        <LucideIcon Name="Plus" Class="w-4 h-4 text-primary" />
                        <span>@L["CreateUser"]</span>
                    </h3>
                    <button type="button" class="text-[#888ea8] hover:text-danger transition cursor-pointer" @onclick="CloseModal">✕</button>
                </div>
                <div class="space-y-4 py-4">
                    <div>
                        <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">@L["Name"] *</label>
                        <input type="text" class="form-input w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border border-gray-200 dark:border-[#191e3a] text-[#0e1726] dark:text-white outline-none" @bind="_createModel.Name" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">@L["Email"] *</label>
                        <input type="email" class="form-input w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border border-gray-200 dark:border-[#191e3a] text-[#0e1726] dark:text-white outline-none" @bind="_createModel.Email" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">@L["Password"] *</label>
                        <input type="password" class="form-input w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border border-gray-200 dark:border-[#191e3a] text-[#0e1726] dark:text-white outline-none" @bind="_createModel.Password" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">@L["Role"]</label>
                        <select class="form-select w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border border-gray-200 dark:border-[#191e3a] text-[#0e1726] dark:text-white outline-none" @bind="_createModel.Role">
                            <option value="User">User</option>
                            <option value="Admin">Admin</option>
                            <option value="Manager">Manager</option>
                        </select>
                    </div>
                </div>
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100 dark:border-[#191e3a]">
                    <button type="button" class="px-4 py-2 rounded-xl text-xs font-semibold text-[#888ea8] hover:bg-gray-100 dark:hover:bg-[#121e32] transition cursor-pointer" @onclick="CloseModal">@L["Cancel"]</button>
                    <button type="button" class="px-4 py-2 rounded-xl text-xs font-bold bg-primary text-white shadow-sm hover:shadow-md transition cursor-pointer" @onclick="CreateUserAsync">@L["Save"]</button>
                </div>
            </div>
        </div>
    }

    <!-- Edit User Modal -->
    @if (_showEditModal && _editingUser != null)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-xs p-4">
            <div class="bg-white dark:bg-[#0e1726] rounded-2xl p-6 w-full max-w-md shadow-xl animate-fade-in border border-gray-100 dark:border-[#1b2e4b]">
                <div class="flex items-center justify-between pb-4 border-b border-gray-100 dark:border-[#191e3a]">
                    <h3 class="text-base font-bold text-[#0e1726] dark:text-white flex items-center gap-2">
                        <LucideIcon Name="Eye" Class="w-4 h-4 text-primary" />
                        <span>@L["Edit"] - @_editingUser.Name</span>
                    </h3>
                    <button type="button" class="text-[#888ea8] hover:text-danger transition cursor-pointer" @onclick="CloseModal">✕</button>
                </div>
                <div class="space-y-4 py-4">
                    <div>
                        <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">@L["Name"] *</label>
                        <input type="text" class="form-input w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border border-gray-200 dark:border-[#191e3a] text-[#0e1726] dark:text-white outline-none" @bind="_updateModel.Name" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">@L["Password"] (@L["Optional"])</label>
                        <input type="password" placeholder="@L["Optional"]" class="form-input w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border border-gray-200 dark:border-[#191e3a] text-[#0e1726] dark:text-white outline-none" @bind="_updateModel.Password" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">@L["Role"]</label>
                        <select class="form-select w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border border-gray-200 dark:border-[#191e3a] text-[#0e1726] dark:text-white outline-none" @bind="_updateModel.Role">
                            <option value="User">User</option>
                            <option value="Admin">Admin</option>
                            <option value="Manager">Manager</option>
                        </select>
                    </div>
                    <div class="flex items-center gap-2 pt-2">
                        <input type="checkbox" id="isActiveCheck" class="checkbox checkbox-primary checkbox-xs rounded cursor-pointer" @bind="_updateModel.IsActive" />
                        <label for="isActiveCheck" class="text-xs font-bold text-[#0e1726] dark:text-white cursor-pointer">@L["Active"]</label>
                    </div>
                </div>
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100 dark:border-[#191e3a]">
                    <button type="button" class="px-4 py-2 rounded-xl text-xs font-semibold text-[#888ea8] hover:bg-gray-100 dark:hover:bg-[#121e32] transition cursor-pointer" @onclick="CloseModal">@L["Cancel"]</button>
                    <button type="button" class="px-4 py-2 rounded-xl text-xs font-bold bg-primary text-white shadow-sm hover:shadow-md transition cursor-pointer" @onclick="SaveEditUserAsync">@L["Save"]</button>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private List<UserDto> _users = new();
    private string _searchTerm = string.Empty;
    private bool _isLoading = true;

    private bool _showCreateModal = false;
    private bool _showEditModal = false;
    private UserDto? _editingUser;

    private CreateUserDto _createModel = new();
    private UpdateUserDto _updateModel = new();

    private List<UserDto> FilteredUsers => string.IsNullOrWhiteSpace(_searchTerm)
        ? _users
        : _users.Where(u => u.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                            u.Email.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        _isLoading = true;
        try
        {
            _users = await UserAppService.GetListAsync();
        }
        catch
        {
            _users = new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        _createModel = new CreateUserDto();
        _showCreateModal = true;
    }

    private void OpenEditModal(UserDto user)
    {
        _editingUser = user;
        _updateModel = new UpdateUserDto
        {
            Name = user.Name,
            Role = user.Role,
            IsActive = user.IsActive
        };
        _showEditModal = true;
    }

    private void CloseModal()
    {
        _showCreateModal = false;
        _showEditModal = false;
        _editingUser = null;
    }

    private async Task CreateUserAsync()
    {
        if (string.IsNullOrWhiteSpace(_createModel.Name) || string.IsNullOrWhiteSpace(_createModel.Email) || string.IsNullOrWhiteSpace(_createModel.Password))
        {
            return;
        }

        try
        {
            await UserAppService.CreateAsync(_createModel);
            CloseModal();
            await LoadUsersAsync();
        }
        catch
        {
            // 异常在生产由全局处理
        }
    }

    private async Task SaveEditUserAsync()
    {
        if (_editingUser == null || string.IsNullOrWhiteSpace(_updateModel.Name)) return;

        try
        {
            await UserAppService.UpdateAsync(_editingUser.Id, _updateModel);
            CloseModal();
            await LoadUsersAsync();
        }
        catch
        {
        }
    }

    private async Task DeleteUserAsync(Guid id)
    {
        try
        {
            await UserAppService.DeleteAsync(id);
            await LoadUsersAsync();
        }
        catch
        {
        }
    }
}
