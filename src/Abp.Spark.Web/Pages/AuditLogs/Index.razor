@page "/audit-logs"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IAuditLogAppService AuditLogAppService
@inject NavigationManager NavigationManager

<PageTitle>@L["AuditLogs"]</PageTitle>

<section class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between gap-4">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0e1726] dark:text-white font-nunito flex items-center gap-3">
            <LucideIcon Name="FileText" Class="w-7 h-7 text-primary" />
            <span>@L["AuditLogs"]</span>
        </h1>

        <div class="flex items-center gap-2">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary">
                @L["AuditComplianceBadge"]
            </span>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card bg-white dark:bg-[#0e1726] rounded-2xl p-5 shadow-sm space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3">
            <div>
                <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">@L["HttpMethod"]</label>
                <select class="form-select w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white outline-none" @bind="_filterHttpMethod">
                    <option value="">@L["AllMethods"]</option>
                    <option value="GET">GET</option>
                    <option value="POST">POST</option>
                    <option value="PUT">PUT</option>
                    <option value="DELETE">DELETE</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">@L["RequestUrl"]</label>
                <input type="text" placeholder="/api/users" class="form-input w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white outline-none" @bind="_filterUrl" />
            </div>
            <div>
                <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">@L["Operator"]</label>
                <input type="text" placeholder="admin" class="form-input w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white outline-none" @bind="_filterUserName" />
            </div>
            <div class="flex items-end gap-2">
                <button type="button" class="flex-1 py-2 rounded-xl text-xs font-bold bg-primary text-white shadow-sm hover:shadow-md transition cursor-pointer" @onclick="LoadLogsAsync">
                    @L["Search"]
                </button>
                <button type="button" class="py-2 px-3 rounded-xl text-xs font-semibold text-[#888ea8] hover:bg-gray-100 dark:hover:bg-[#121e32] transition cursor-pointer" @onclick="ResetFilterAsync">
                    @L["Reset"]
                </button>
            </div>
        </div>
    </div>

    <!-- Audit Log Table Card -->
    <div class="card bg-white dark:bg-[#0e1726] rounded-2xl p-6 shadow-sm">
        <div class="flex items-center justify-between mb-4">
            <div class="text-xs text-[#888ea8] font-semibold">
                @L["Total"]: <span class="text-primary font-bold font-mono">@_totalCount</span>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-[#506690] dark:text-[#888ea8]">
                <thead>
                    <tr class="border-b border-gray-100 dark:border-[#191e3a] text-[#0e1726] dark:text-white font-extrabold uppercase tracking-wider text-[11px]">
                        <th class="py-3 px-4">@L["Endpoint"]</th>
                        <th class="py-3 px-4">@L["StatusCode"]</th>
                        <th class="py-3 px-4">@L["Operator"]</th>
                        <th class="py-3 px-4">@L["Duration"]</th>
                        <th class="py-3 px-4">@L["ClientIp"]</th>
                        <th class="py-3 px-4">@L["Time"]</th>
                        <th class="py-3 px-4 text-right">@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-[#191e3a]">
                    @if (_isLoading)
                    {
                        <tr>
                            <td colspan="7" class="py-12 text-center text-sm text-[#888ea8]">
                                @L["Loading"]
                            </td>
                        </tr>
                    }
                    else if (!_logs.Any())
                    {
                        <tr>
                            <td colspan="7" class="py-12 text-center text-sm text-[#888ea8]">
                                @L["NoData"]
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in _logs)
                        {
                            <tr class="hover:bg-[#f8f9fa] dark:hover:bg-[#121e32]/60 transition-colors">
                                <td class="py-3.5 px-4">
                                    <div class="flex items-center gap-2">
                                        @switch (log.HttpMethod?.ToUpperInvariant())
                                        {
                                            case "GET":
                                                <span class="px-2 py-0.5 rounded-md text-[10px] font-extrabold bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400">GET</span>
                                                break;
                                            case "POST":
                                                <span class="px-2 py-0.5 rounded-md text-[10px] font-extrabold bg-emerald-50 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400">POST</span>
                                                break;
                                            case "PUT":
                                                <span class="px-2 py-0.5 rounded-md text-[10px] font-extrabold bg-amber-50 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400">PUT</span>
                                                break;
                                            case "DELETE":
                                                <span class="px-2 py-0.5 rounded-md text-[10px] font-extrabold bg-rose-50 text-rose-600 dark:bg-rose-900/30 dark:text-rose-400">DEL</span>
                                                break;
                                            default:
                                                <span class="px-2 py-0.5 rounded-md text-[10px] font-extrabold bg-gray-100 text-gray-600">@log.HttpMethod</span>
                                                break;
                                        }
                                        <span class="font-mono text-xs text-[#0e1726] dark:text-white truncate max-w-xs" title="@log.Url">
                                            @log.Url
                                        </span>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4">
                                    @if (log.HttpStatusCode >= 200 && log.HttpStatusCode < 300)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-success/10 text-success">
                                            @log.HttpStatusCode
                                        </span>
                                    }
                                    else if (log.HttpStatusCode >= 400)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-danger/10 text-danger">
                                            @log.HttpStatusCode
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-primary/10 text-primary">
                                            @log.HttpStatusCode
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 font-semibold text-[#0e1726] dark:text-white">
                                    @(string.IsNullOrWhiteSpace(log.UserName) ? L["Anonymous"] : log.UserName)
                                </td>
                                <td class="py-3.5 px-4">
                                    @if (log.ExecutionDuration > 500)
                                    {
                                        <span class="text-amber-500 font-bold">@log.ExecutionDuration ms</span>
                                    }
                                    else
                                    {
                                        <span class="text-success font-medium">@log.ExecutionDuration ms</span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 font-mono text-[11px]">@log.ClientIpAddress</td>
                                <td class="py-3.5 px-4 text-[11px] text-[#888ea8]">@log.ExecutionTime</td>
                                <td class="py-3.5 px-4 text-right">
                                    <button type="button"
                                            class="w-7 h-7 rounded-lg flex items-center justify-center text-[#888ea8] hover:text-primary hover:bg-primary/10 transition cursor-pointer ml-auto"
                                            title="@L["Details"]"
                                            @onclick="() => ShowDetail(log)">
                                        <LucideIcon Name="Eye" Class="w-3.5 h-3.5" />
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Detail Modal -->
    @if (_selectedLog != null)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-xs p-4">
            <div class="bg-white dark:bg-[#0e1726] rounded-2xl p-6 w-full max-w-2xl max-h-[85vh] flex flex-col shadow-xl animate-fade-in">
                <div class="flex items-center justify-between pb-4 border-b border-gray-100 dark:border-[#191e3a]">
                    <h3 class="text-base font-bold text-[#0e1726] dark:text-white flex items-center gap-2">
                        <LucideIcon Name="FileText" Class="w-5 h-5 text-primary" />
                        <span>@L["AuditDetailTitle"]</span>
                    </h3>
                    <button type="button" class="text-[#888ea8] hover:text-danger transition cursor-pointer" @onclick="(() => _selectedLog = null)">✕</button>
                </div>
                <div class="flex-1 overflow-y-auto py-4 space-y-4 font-mono text-xs">
                    <div class="p-3 bg-[#f6f8fa] dark:bg-[#121e32] rounded-xl space-y-1">
                        <div><strong class="text-primary">@L["HttpMethod"]:</strong> @_selectedLog.HttpMethod</div>
                        <div><strong class="text-primary">@L["RequestUrl"]:</strong> @_selectedLog.Url</div>
                        <div><strong class="text-primary">@L["StatusCode"]:</strong> @_selectedLog.HttpStatusCode</div>
                        <div><strong class="text-primary">@L["Duration"]:</strong> @_selectedLog.ExecutionDuration ms</div>
                        <div><strong class="text-primary">@L["Operator"]:</strong> @_selectedLog.UserName (@_selectedLog.UserId)</div>
                        <div><strong class="text-primary">@L["ClientIp"]:</strong> @_selectedLog.ClientIpAddress</div>
                        <div><strong class="text-primary">@L["BrowserInfo"]:</strong> @_selectedLog.BrowserInfo</div>
                        <div><strong class="text-primary">@L["CorrelationId"]:</strong> @_selectedLog.CorrelationId</div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_selectedLog.Exceptions))
                    {
                        <div>
                            <div class="font-bold text-danger mb-1 font-sans">@L["ExceptionStack"]:</div>
                            <pre class="p-3 bg-danger/10 text-danger rounded-xl overflow-x-auto text-[11px] whitespace-pre-wrap">@_selectedLog.Exceptions</pre>
                        </div>
                    }
                </div>
                <div class="flex items-center justify-end pt-4 border-t border-gray-100 dark:border-[#191e3a]">
                    <button type="button" class="px-4 py-2 rounded-xl text-xs font-bold bg-primary text-white shadow-sm hover:shadow-md transition cursor-pointer" @onclick="(() => _selectedLog = null)">@L["Close"]</button>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private List<PagingAuditLogOutput> _logs = new();
    private long _totalCount = 0;
    private bool _isLoading = true;

    private string _filterHttpMethod = string.Empty;
    private string _filterUrl = string.Empty;
    private string _filterUserName = string.Empty;

    private PagingAuditLogOutput? _selectedLog;

    protected override async Task OnInitializedAsync()
    {
        await LoadLogsAsync();
    }

    private async Task LoadLogsAsync()
    {
        _isLoading = true;
        try
        {
            var input = new PagingAuditLogInput
            {
                PageIndex = 1,
                PageSize = 20,
                HttpMethod = string.IsNullOrWhiteSpace(_filterHttpMethod) ? null : _filterHttpMethod,
                Url = string.IsNullOrWhiteSpace(_filterUrl) ? null : _filterUrl,
                UserName = string.IsNullOrWhiteSpace(_filterUserName) ? null : _filterUserName
            };

            var res = await AuditLogAppService.GetListAsync(input);
            _logs = res.Items?.ToList() ?? new();
            _totalCount = res.TotalCount;
        }
        catch
        {
            _logs = new();
            _totalCount = 0;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ResetFilterAsync()
    {
        _filterHttpMethod = string.Empty;
        _filterUrl = string.Empty;
        _filterUserName = string.Empty;
        await LoadLogsAsync();
    }

    private void ShowDetail(PagingAuditLogOutput log)
    {
        _selectedLog = log;
    }
}
