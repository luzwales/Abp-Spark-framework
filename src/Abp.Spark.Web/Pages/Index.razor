@page "/"
@inject NavigationManager NavigationManager

@code {
    [CascadingParameter] public PageState PageState { get; set; } = default!;

    protected override void OnInitialized()
    {
        // 若已登录，无缝直达工作台仪表盘
        if (PageState?.User?.IsAuthenticated == true)
        {
            NavigationManager.NavigateTo("dashboard");
        }
    }
}

<PageTitle>@(L["home"] != "home" ? L["home"] : "首页 - ABP Spark 智能制造架构平台")</PageTitle>

<div class="space-y-6">
    <!-- Hero Banner Card (Vristo Style Gradient & Borderless) -->
    <div class="card bg-white dark:bg-[#0e1726] shadow-sm rounded-2xl overflow-hidden border-0">
        <div class="p-6 sm:p-10 relative">
            <div class="max-w-3xl space-y-4">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold tracking-wide">
                    <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                    ABP vNext 10.7.1 + Blazor In-Process Monolith
                </div>
                <h1 class="text-3xl sm:text-4xl font-extrabold text-[#0e1726] dark:text-white font-nunito tracking-tight leading-tight">
                    企业级智能制造敏捷开发平台
                </h1>
                <p class="text-sm sm:text-base text-[#506690] dark:text-[#888ea8] leading-relaxed">
                    基于 ABP vNext 企业级 DDD 规范打造，深度集成 Lion.AbpPro 体系与现代轻量级 Vristo Blazor 界面。原生支持 SQL Server / PostgreSQL / MySQL / SQLite 多数据源无缝热切与细粒度权限控制。
                </p>

                <div class="pt-2 flex flex-wrap items-center gap-3">
                    @if (PageState?.User?.IsAuthenticated == true)
                    {
                        <a href="/dashboard" class="btn btn-primary text-xs sm:text-sm font-semibold shadow-sm flex items-center gap-2">
                            <LucideIcon Name="LayoutDashboard" Class="w-4 h-4" />
                            进入工作台仪表盘
                        </a>
                        <a href="/customers" class="btn btn-outline-primary text-xs sm:text-sm font-semibold flex items-center gap-2">
                            <LucideIcon Name="Factory" Class="w-4 h-4" />
                            制造客户档案
                        </a>
                    }
                    else
                    {
                        <a href="/login" class="btn btn-primary text-xs sm:text-sm font-semibold shadow-sm flex items-center gap-2">
                            <LucideIcon Name="LogIn" Class="w-4 h-4" />
                            立即登录控制台
                        </a>
                        <a href="/login" class="btn btn-outline text-xs sm:text-sm font-semibold flex items-center gap-2 text-[#506690] dark:text-[#888ea8]">
                            默认超管: admin / 1q2w3E*
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Feature Matrix Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="card bg-white dark:bg-[#0e1726] shadow-sm rounded-2xl p-6 border-0">
            <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-4">
                <LucideIcon Name="Factory" Class="w-6 h-6" />
            </div>
            <h3 class="text-base font-bold text-[#0e1726] dark:text-white mb-2">智能制造客户全生命周期</h3>
            <p class="text-xs text-[#506690] dark:text-[#888ea8] leading-relaxed">
                包含宁德时代、比亚迪等工业实体 CRUD、行业分类、信用评级、统一社会信用代码与账期风控管理。
            </p>
        </div>

        <div class="card bg-white dark:bg-[#0e1726] shadow-sm rounded-2xl p-6 border-0">
            <div class="w-12 h-12 rounded-xl bg-secondary/10 text-secondary flex items-center justify-center mb-4">
                <LucideIcon Name="ShieldCheck" Class="w-6 h-6" />
            </div>
            <h3 class="text-base font-bold text-[#0e1726] dark:text-white mb-2">细粒度安全与组织级联授权</h3>
            <p class="text-xs text-[#506690] dark:text-[#888ea8] leading-relaxed">
                支持部门角色绑定、子部门向下级联继承、部门主管一键设定下属所有子部门负责人全套企业级组织权限。
            </p>
        </div>

        <div class="card bg-white dark:bg-[#0e1726] shadow-sm rounded-2xl p-6 border-0">
            <div class="w-12 h-12 rounded-xl bg-success/10 text-success flex items-center justify-center mb-4">
                <LucideIcon Name="BookOpen" Class="w-6 h-6" />
            </div>
            <h3 class="text-base font-bold text-[#0e1726] dark:text-white mb-2">字典与系统治理中台</h3>
            <p class="text-xs text-[#506690] dark:text-[#888ea8] leading-relaxed">
                提供工单状态、缺陷等级、检验工序三级代码字典，集成全审计日志检索耗时分析与站内广播预警。
            </p>
        </div>
    </div>
</div>
