@page "/languages"
@attribute [Authorize]
@inject ILanguageAppService LanguageAppService
@inject ILanguageTextAppService LanguageTextAppService
@inject NavigationManager NavigationManager

<PageTitle>@L["Languages"]</PageTitle>

<section class="space-y-6">
    <!-- Breadcrumb & Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <ul class="flex items-center gap-2 text-xs text-[#888ea8] mb-1 font-semibold">
                <li><a href="/" class="hover:text-primary transition-colors">@L["home"]</a></li>
                <li><span>/</span></li>
                <li><a href="/dashboard" class="hover:text-primary transition-colors">@L["Dashboard"]</a></li>
                <li><span>/</span></li>
                <li class="text-primary font-bold">@L["Languages"]</li>
            </ul>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0e1726] dark:text-white font-nunito flex items-center gap-3">
                <LucideIcon Name="Languages" Class="w-7 h-7 text-primary" />
                <span>@L["Languages"]</span>
            </h1>
        </div>

        <div class="flex items-center gap-3">
            @if (_currentTab == "Languages")
            {
                <button type="button"
                        class="btn btn-primary flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold shadow-sm hover:shadow-md transition cursor-pointer"
                        onclick="@OpenCreateLangModal">
                    <LucideIcon Name="Languages" Class="w-4 h-4 text-white" />
                    <span>新增语种</span>
                </button>
            }
        </div>
    </div>

    <!-- Main Card with Tab Navigation -->
    <div class="card bg-white dark:bg-[#0e1726] rounded-2xl p-6 shadow-sm space-y-5">
        <!-- Tabs -->
        <div class="flex items-center gap-3 border-b border-gray-100 dark:border-[#191e3a] pb-3">
            <button type="button"
                    class="px-4 py-2 rounded-xl text-xs font-bold transition @(_currentTab == "Languages" ? "bg-primary text-white" : "text-[#888ea8] hover:text-[#0e1726] dark:hover:text-white")"
                    onclick="@(() => SwitchTab("Languages"))">
                系统语种列表
            </button>
            <button type="button"
                    class="px-4 py-2 rounded-xl text-xs font-bold transition @(_currentTab == "Texts" ? "bg-primary text-white" : "text-[#888ea8] hover:text-[#0e1726] dark:hover:text-white")"
                    onclick="@(() => SwitchTab("Texts"))">
                词条翻译维护 (Texts)
            </button>
        </div>

        <!-- TAB 1: Languages List -->
        @if (_currentTab == "Languages")
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-[#506690] dark:text-[#888ea8]">
                    <thead>
                        <tr class="border-b border-gray-100 dark:border-[#191e3a] text-[#0e1726] dark:text-white font-extrabold uppercase tracking-wider text-[11px]">
                            <th class="py-3 px-3">显示名称</th>
                            <th class="py-3 px-3">区域文化代码 (Culture)</th>
                            <th class="py-3 px-3">UI 语言代码</th>
                            <th class="py-3 px-3 text-center">默认语言</th>
                            <th class="py-3 px-3 text-right">操作</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-[#191e3a]">
                        @if (_isLoadingLangs)
                        {
                            <tr>
                                <td colspan="5" class="py-12 text-center text-xs text-[#888ea8]">正在读取语种列表...</td>
                            </tr>
                        }
                        else if (!_languages.Any())
                        {
                            <tr>
                                <td colspan="5" class="py-12 text-center text-xs text-[#888ea8]">暂无配置语种</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var l in _languages)
                            {
                                <tr class="hover:bg-[#f8f9fa] dark:hover:bg-[#121e32]/60 transition-colors">
                                    <td class="py-3.5 px-3 font-bold text-[#0e1726] dark:text-white">
                                        @l.DisplayName
                                    </td>
                                    <td class="py-3.5 px-3 font-mono text-[11px] text-primary font-bold">
                                        @l.CultureName
                                    </td>
                                    <td class="py-3.5 px-3 font-mono text-[#888ea8]">
                                        @l.UiCultureName
                                    </td>
                                    <td class="py-3.5 px-3 text-center">
                                        @if (l.IsDefault)
                                        {
                                            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-success/10 text-success">
                                                ● 默认语种
                                            </span>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="text-[11px] text-primary hover:underline cursor-pointer"
                                                    onclick="@(() => SetDefaultLangAsync(l.Id))">
                                                设为默认
                                            </button>
                                        }
                                    </td>
                                    <td class="py-3.5 px-3 text-right">
                                        <button type="button"
                                                class="w-7 h-7 rounded-lg flex items-center justify-center text-[#888ea8] hover:text-danger hover:bg-danger/10 transition cursor-pointer ml-auto"
                                                title="删除语种"
                                                onclick="@(() => DeleteLangAsync(l.Id))">
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M3 6h18"/>
                                                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                            </svg>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- TAB 2: Language Texts -->
        @if (_currentTab == "Texts")
        {
            <div class="space-y-4">
                <!-- Filters -->
                <div class="grid grid-cols-1 sm:grid-cols-12 gap-3">
                    <div class="sm:col-span-4">
                        <select class="form-select w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white outline-none"
                                @bind="_selectedCulture"
                                @bind:after="LoadTextsAsync">
                            <option value="zh-Hans">简体中文 (zh-Hans)</option>
                            <option value="en">English (en)</option>
                            @foreach (var l in _languages.Where(x => x.CultureName != "zh-Hans" && x.CultureName != "en"))
                            {
                                <option value="@l.CultureName">@l.DisplayName (@l.CultureName)</option>
                            }
                        </select>
                    </div>
                    <div class="sm:col-span-8 relative">
                        <input type="text"
                               placeholder="搜索多语言键 (Key) 或文本 (Value)..."
                               class="form-input w-full pl-9 pr-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white placeholder-[#888ea8] outline-none"
                               @bind="_textFilter"
                               @bind:event="oninput"
                               @onkeyup="@HandleTextSearchKeyUp" />
                        <div class="absolute left-3 top-2.5 text-[#888ea8]">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"/>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                            </svg>
                        </div>
                    </div>
                </div>

                <!-- Texts Table -->
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs text-[#506690] dark:text-[#888ea8]">
                        <thead>
                            <tr class="border-b border-gray-100 dark:border-[#191e3a] text-[#0e1726] dark:text-white font-extrabold uppercase tracking-wider text-[11px]">
                                <th class="py-3 px-3">多语言键 (Name / Key)</th>
                                <th class="py-3 px-3">翻译内容 (Value)</th>
                                <th class="py-3 px-3 text-right">操作</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 dark:divide-[#191e3a]">
                            @if (_isLoadingTexts)
                            {
                                <tr>
                                    <td colspan="3" class="py-12 text-center text-xs text-[#888ea8]">正在读取多语言词条...</td>
                                </tr>
                            }
                            else if (!_texts.Any())
                            {
                                <tr>
                                    <td colspan="3" class="py-12 text-center text-xs text-[#888ea8]">未检索到匹配的词条</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var txt in _texts)
                                {
                                    <tr class="hover:bg-[#f8f9fa] dark:hover:bg-[#121e32]/60 transition-colors">
                                        <td class="py-3.5 px-3 font-mono font-bold text-[#0e1726] dark:text-white">
                                            @txt.Name
                                        </td>
                                        <td class="py-3.5 px-3 text-[#0e1726] dark:text-white">
                                            @txt.Value
                                        </td>
                                        <td class="py-3.5 px-3 text-right">
                                            <button type="button"
                                                    class="px-2.5 py-1 rounded-lg text-[11px] font-bold text-primary hover:bg-primary/10 transition cursor-pointer"
                                                    onclick="@(() => OpenEditTextModal(txt))">
                                                编辑翻译
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <!-- Create Language Modal -->
    @if (_showCreateLangModal)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-xs p-4">
            <div class="bg-white dark:bg-[#0e1726] rounded-2xl p-6 w-full max-w-md shadow-xl animate-fade-in">
                <div class="flex items-center justify-between pb-4 border-b border-gray-100 dark:border-[#191e3a]">
                    <h3 class="text-base font-bold text-[#0e1726] dark:text-white">新增语种</h3>
                    <button type="button" class="text-[#888ea8] hover:text-danger transition cursor-pointer" onclick="@CloseModal">✕</button>
                </div>
                <div class="space-y-4 py-4">
                    <div>
                        <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">区域代码 (CultureName)</label>
                        <input type="text" class="form-input w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white outline-none" @bind="_newCultureName" placeholder="例如：ja, de, fr, es" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">显示名称 (DisplayName)</label>
                        <input type="text" class="form-input w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white outline-none" @bind="_newDisplayName" placeholder="例如：日本語, Deutsch, Français" />
                    </div>
                </div>
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100 dark:border-[#191e3a]">
                    <button type="button" class="px-4 py-2 rounded-xl text-xs font-semibold text-[#888ea8] hover:bg-gray-100 dark:hover:bg-[#121e32] transition cursor-pointer" onclick="@CloseModal">取消</button>
                    <button type="button" class="px-4 py-2 rounded-xl text-xs font-bold bg-primary text-white shadow-sm hover:shadow-md transition cursor-pointer" onclick="@CreateLanguageAsync">保存创建</button>
                </div>
            </div>
        </div>
    }

    <!-- Edit Text Modal -->
    @if (_showEditTextModal && _editingText != null)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-xs p-4">
            <div class="bg-white dark:bg-[#0e1726] rounded-2xl p-6 w-full max-w-md shadow-xl animate-fade-in">
                <div class="flex items-center justify-between pb-4 border-b border-gray-100 dark:border-[#191e3a]">
                    <h3 class="text-base font-bold text-[#0e1726] dark:text-white">编辑词条翻译</h3>
                    <button type="button" class="text-[#888ea8] hover:text-danger transition cursor-pointer" onclick="@CloseModal">✕</button>
                </div>
                <div class="space-y-4 py-4">
                    <div>
                        <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">词条键 (Key)</label>
                        <input type="text" readonly class="form-input w-full px-3 py-2 rounded-xl text-xs bg-gray-100 dark:bg-[#121e32] border-none text-[#888ea8] outline-none font-mono" value="@_editingText.Name" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">翻译文本 (Value - @_selectedCulture)</label>
                        <textarea class="form-input w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white outline-none" rows="3" @bind="_editTextValue"></textarea>
                    </div>
                </div>
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100 dark:border-[#191e3a]">
                    <button type="button" class="px-4 py-2 rounded-xl text-xs font-semibold text-[#888ea8] hover:bg-gray-100 dark:hover:bg-[#121e32] transition cursor-pointer" onclick="@CloseModal">取消</button>
                    <button type="button" class="px-4 py-2 rounded-xl text-xs font-bold bg-primary text-white shadow-sm hover:shadow-md transition cursor-pointer" onclick="@SaveTextTranslationAsync">保存修改</button>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private string _currentTab = "Languages";

    // Languages Tab
    private List<PageLanguageOutput> _languages = new();
    private bool _isLoadingLangs = true;
    private bool _showCreateLangModal = false;
    private string _newCultureName = string.Empty;
    private string _newDisplayName = string.Empty;

    // Texts Tab
    private string _selectedCulture = "zh-Hans";
    private string _textFilter = string.Empty;
    private List<PageLanguageTextOutput> _texts = new();
    private bool _isLoadingTexts = false;
    private bool _showEditTextModal = false;
    private PageLanguageTextOutput? _editingText;
    private string _editTextValue = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadLanguagesAsync();
    }

    private async Task SwitchTab(string tab)
    {
        _currentTab = tab;
        if (tab == "Texts" && !_texts.Any())
        {
            await LoadTextsAsync();
        }
    }

    private async Task LoadLanguagesAsync()
    {
        _isLoadingLangs = true;
        try
        {
            _languages = await LanguageAppService.AllListAsync();
        }
        catch
        {
            _languages = new();
        }
        finally
        {
            _isLoadingLangs = false;
        }
    }

    private void OpenCreateLangModal()
    {
        _newCultureName = string.Empty;
        _newDisplayName = string.Empty;
        _showCreateLangModal = true;
    }

    private async Task CreateLanguageAsync()
    {
        if (string.IsNullOrWhiteSpace(_newCultureName) || string.IsNullOrWhiteSpace(_newDisplayName)) return;
        try
        {
            await LanguageAppService.CreateAsync(new CreateLanguageInput
            {
                CultureName = _newCultureName,
                UiCultureName = _newCultureName,
                DisplayName = _newDisplayName,
                FlagIcon = string.Empty,
                IsEnabled = true
            });
            CloseModal();
            await LoadLanguagesAsync();
        }
        catch
        {
        }
    }

    private async Task SetDefaultLangAsync(Guid id)
    {
        try
        {
            await LanguageAppService.SetDefaultAsync(new Lion.AbpPro.Core.IdInput { Id = id });
            await LoadLanguagesAsync();
        }
        catch
        {
        }
    }

    private async Task DeleteLangAsync(Guid id)
    {
        try
        {
            await LanguageAppService.DeleteAsync(new DeleteLanguageInput { Id = id });
            await LoadLanguagesAsync();
        }
        catch
        {
        }
    }

    private async Task LoadTextsAsync()
    {
        _isLoadingTexts = true;
        try
        {
            var res = await LanguageTextAppService.PageAsync(new PageLanguageTextInput
            {
                CultureName = _selectedCulture,
                Filter = _textFilter,
                PageIndex = 1,
                PageSize = 50
            });
            _texts = res.Items?.ToList() ?? new();
        }
        catch
        {
            _texts = new();
        }
        finally
        {
            _isLoadingTexts = false;
        }
    }

    private async Task HandleTextSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadTextsAsync();
        }
    }

    private void OpenEditTextModal(PageLanguageTextOutput txt)
    {
        _editingText = txt;
        _editTextValue = txt.Value;
        _showEditTextModal = true;
    }

    private async Task SaveTextTranslationAsync()
    {
        if (_editingText == null) return;
        try
        {
            await LanguageTextAppService.UpdateAsync(new UpdateLanguageTextInput
            {
                CultureName = _selectedCulture,
                Name = _editingText.Name,
                Value = _editTextValue,
                ResourceName = _editingText.ResourceName ?? "AbpPro"
            });
            _editingText.Value = _editTextValue;
            CloseModal();
        }
        catch
        {
        }
    }

    private void CloseModal()
    {
        _showCreateLangModal = false;
        _showEditTextModal = false;
    }
}
