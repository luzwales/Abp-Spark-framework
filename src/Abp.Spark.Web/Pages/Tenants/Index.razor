@page "/tenants"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ITenantAppService TenantAppService
@inject NavigationManager NavigationManager

<PageTitle>@L["Tenants"]</PageTitle>

<section class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between gap-4">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0e1726] dark:text-white font-nunito flex items-center gap-3">
            <LucideIcon Name="Building" Class="w-7 h-7 text-primary" />
            <span>@L["Tenants"]</span>
        </h1>

        <div class="flex items-center gap-2">
            <button type="button"
                    class="w-8 h-8 rounded-lg flex items-center justify-center bg-transparent text-[#888ea8] hover:text-white hover:bg-primary transition cursor-pointer"
                    title="@L["Create"]"
                    @onclick="OpenCreateModal">
                <LucideIcon Name="Plus" Class="w-4 h-4" />
            </button>
        </div>
    </div>

    <!-- Filter & Table Card -->
    <div class="card bg-white dark:bg-[#0e1726] rounded-2xl p-6 shadow-sm space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="relative w-full sm:w-72">
                <input type="text"
                       placeholder="@L["search_placeholder"]"
                       class="form-input w-full pl-9 pr-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white placeholder-[#888ea8] outline-none"
                       @bind="_filterText"
                       @bind:event="oninput"
                       @onkeyup="@HandleSearchKeyUp" />
                <div class="absolute left-3 top-2.5 text-[#888ea8]">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                </div>
            </div>

            <div class="text-xs text-[#888ea8] font-semibold">
                @L["Total"]: <span class="text-primary font-bold font-mono">@_totalCount</span>
            </div>
        </div>

        <!-- Tenants Table -->
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-[#506690] dark:text-[#888ea8]">
                <thead>
                    <tr class="border-b border-gray-100 dark:border-[#191e3a] text-[#0e1726] dark:text-white font-extrabold uppercase tracking-wider text-[11px]">
                        <th class="py-3 px-3">@L["TenantName"]</th>
                        <th class="py-3 px-3">@L["TenantId"]</th>
                        <th class="py-3 px-3 text-center">@L["ConnectionString"]</th>
                        <th class="py-3 px-3 text-right">@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-[#191e3a]">
                    @if (_isLoading)
                    {
                        <tr>
                            <td colspan="4" class="py-12 text-center text-xs text-[#888ea8]">@L["Loading"]</td>
                        </tr>
                    }
                    else if (!_tenants.Any())
                    {
                        <tr>
                            <td colspan="4" class="py-12 text-center text-xs text-[#888ea8]">@L["NoData"]</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var t in _tenants)
                        {
                            <tr class="hover:bg-[#f8f9fa] dark:hover:bg-[#121e32]/60 transition-colors">
                                <td class="py-3.5 px-3 font-bold text-[#0e1726] dark:text-white">
                                    <div class="flex items-center gap-2">
                                        <div class="w-7 h-7 rounded-lg bg-primary/10 text-primary flex items-center justify-center font-bold">
                                            @t.Name.FirstOrDefault()
                                        </div>
                                        <span>@t.Name</span>
                                    </div>
                                </td>
                                <td class="py-3.5 px-3 font-mono text-[11px] text-[#888ea8]">
                                    @t.Id
                                </td>
                                <td class="py-3.5 px-3 text-center">
                                    <button type="button"
                                            class="w-7 h-7 rounded-lg inline-flex items-center justify-center text-[#888ea8] hover:text-primary hover:bg-primary/10 transition cursor-pointer"
                                            title="@L["ConfigConnString"]"
                                            @onclick="() => OpenConnectionStringsModal(t)">
                                        <LucideIcon Name="Settings" Class="w-3.5 h-3.5" />
                                    </button>
                                </td>
                                <td class="py-3.5 px-3 text-right">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <button type="button"
                                                class="w-7 h-7 rounded-lg flex items-center justify-center text-[#888ea8] hover:text-primary hover:bg-primary/10 transition cursor-pointer"
                                                title="@L["Edit"]"
                                                @onclick="() => OpenEditModal(t)">
                                            <LucideIcon Name="Eye" Class="w-3.5 h-3.5" />
                                        </button>
                                        <button type="button"
                                                class="w-7 h-7 rounded-lg flex items-center justify-center text-[#888ea8] hover:text-danger hover:bg-danger/10 transition cursor-pointer"
                                                title="@L["Delete"]"
                                                @onclick="() => DeleteTenantAsync(t.Id)">
                                            <LucideIcon Name="Trash2" Class="w-3.5 h-3.5" />
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Create / Edit Tenant Modal -->
    @if (_showEditModal)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-xs p-4">
            <div class="bg-white dark:bg-[#0e1726] rounded-2xl p-6 w-full max-w-md shadow-xl animate-fade-in">
                <div class="flex items-center justify-between pb-4 border-b border-gray-100 dark:border-[#191e3a]">
                    <h3 class="text-base font-bold text-[#0e1726] dark:text-white">
                        @(_isEditMode ? L["EditTenant"] : L["CreateTenant"])
                    </h3>
                    <button type="button" class="text-[#888ea8] hover:text-danger transition cursor-pointer" @onclick="CloseModal">✕</button>
                </div>
                <div class="space-y-4 py-4">
                    <div>
                        <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">@L["TenantName"] *</label>
                        <input type="text"
                               class="form-input w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white outline-none"
                               @bind="_tenantFormName"
                               placeholder="e.g. Acme-Corp" />
                    </div>
                    @if (!_isEditMode)
                    {
                        <div>
                            <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">@L["AdminEmail"]</label>
                            <input type="email"
                                   class="form-input w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white outline-none"
                                   @bind="_tenantAdminEmail"
                                   placeholder="admin@tenant.com" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">@L["AdminPassword"]</label>
                            <input type="password"
                                   class="form-input w-full px-3 py-2 rounded-xl text-xs bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white outline-none"
                                   @bind="_tenantAdminPassword"
                                   placeholder="Password123!" />
                        </div>
                    }
                </div>
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100 dark:border-[#191e3a]">
                    <button type="button" class="px-4 py-2 rounded-xl text-xs font-semibold text-[#888ea8] hover:bg-gray-100 dark:hover:bg-[#121e32] transition cursor-pointer" @onclick="CloseModal">@L["Cancel"]</button>
                    <button type="button" class="px-4 py-2 rounded-xl text-xs font-bold bg-primary text-white shadow-sm hover:shadow-md transition cursor-pointer" @onclick="SaveTenantAsync">@L["Save"]</button>
                </div>
            </div>
        </div>
    }

    <!-- Connection Strings Modal -->
    @if (_showConnModal && _currentManagingTenant != null)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-xs p-4">
            <div class="bg-white dark:bg-[#0e1726] rounded-2xl p-6 w-full max-w-lg shadow-xl animate-fade-in space-y-4">
                <div class="flex items-center justify-between pb-4 border-b border-gray-100 dark:border-[#191e3a]">
                    <h3 class="text-base font-bold text-[#0e1726] dark:text-white">
                        @L["ConfigConnString"] - @_currentManagingTenant.Name
                    </h3>
                    <button type="button" class="text-[#888ea8] hover:text-danger transition cursor-pointer" @onclick="CloseModal">✕</button>
                </div>

                <div class="space-y-3">
                    <p class="text-xs text-[#888ea8]">
                        @L["ConnStringDesc"]
                    </p>

                    <div>
                        <label class="block text-xs font-bold text-[#0e1726] dark:text-white mb-1">@L["DefaultConnString"]</label>
                        <textarea class="form-input w-full px-3 py-2 rounded-xl text-xs font-mono bg-[#f6f8fa] dark:bg-[#121e32] border-none text-[#0e1726] dark:text-white outline-none"
                                  rows="3"
                                  @bind="_customConnString"
                                  placeholder="Server=127.0.0.1;Database=AbpSparkTenant1;..."></textarea>
                    </div>
                </div>

                <div class="flex items-center justify-between pt-4 border-t border-gray-100 dark:border-[#191e3a]">
                    <button type="button"
                            class="px-3 py-2 rounded-xl text-xs font-semibold text-danger hover:bg-danger/10 transition cursor-pointer"
                            @onclick="DeleteConnectionStringAsync">
                        @L["ClearConnString"]
                    </button>
                    <div class="flex items-center gap-2">
                        <button type="button" class="px-4 py-2 rounded-xl text-xs font-semibold text-[#888ea8] hover:bg-gray-100 dark:hover:bg-[#121e32] transition cursor-pointer" @onclick="CloseModal">@L["Cancel"]</button>
                        <button type="button" class="px-4 py-2 rounded-xl text-xs font-bold bg-primary text-white shadow-sm hover:shadow-md transition cursor-pointer" @onclick="SaveConnectionStringAsync">@L["Save"]</button>
                    </div>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private List<TenantDto> _tenants = new();
    private long _totalCount = 0;
    private bool _isLoading = true;
    private string _filterText = string.Empty;

    private bool _showEditModal = false;
    private bool _isEditMode = false;
    private Guid _editingTenantId = Guid.Empty;
    private string _tenantFormName = string.Empty;
    private string _tenantAdminEmail = string.Empty;
    private string _tenantAdminPassword = string.Empty;

    private bool _showConnModal = false;
    private TenantDto? _currentManagingTenant;
    private string _customConnString = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadTenantsAsync();
    }

    private async Task LoadTenantsAsync()
    {
        _isLoading = true;
        try
        {
            var res = await TenantAppService.GetListAsync(new GetTenantsInput
            {
                Filter = _filterText,
                SkipCount = 0,
                MaxResultCount = 50
            });
            _tenants = res.Items?.ToList() ?? new();
            _totalCount = res.TotalCount;
        }
        catch
        {
            _tenants = new();
            _totalCount = 0;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadTenantsAsync();
        }
    }

    private void OpenCreateModal()
    {
        _isEditMode = false;
        _editingTenantId = Guid.Empty;
        _tenantFormName = string.Empty;
        _tenantAdminEmail = string.Empty;
        _tenantAdminPassword = string.Empty;
        _showEditModal = true;
    }

    private void OpenEditModal(TenantDto t)
    {
        _isEditMode = true;
        _editingTenantId = t.Id;
        _tenantFormName = t.Name;
        _showEditModal = true;
    }

    private async Task SaveTenantAsync()
    {
        if (string.IsNullOrWhiteSpace(_tenantFormName)) return;

        try
        {
            if (_isEditMode)
            {
                await TenantAppService.UpdateAsync(_editingTenantId, new TenantUpdateDto
                {
                    Name = _tenantFormName
                });
            }
            else
            {
                await TenantAppService.CreateAsync(new TenantCreateDto
                {
                    Name = _tenantFormName,
                    AdminEmailAddress = string.IsNullOrWhiteSpace(_tenantAdminEmail) ? "admin@" + _tenantFormName.ToLower() + ".com" : _tenantAdminEmail,
                    AdminPassword = string.IsNullOrWhiteSpace(_tenantAdminPassword) ? "Password123!" : _tenantAdminPassword
                });
            }

            CloseModal();
            await LoadTenantsAsync();
        }
        catch
        {
        }
    }

    private async Task DeleteTenantAsync(Guid id)
    {
        try
        {
            await TenantAppService.DeleteAsync(id);
            await LoadTenantsAsync();
        }
        catch
        {
        }
    }

    private async Task OpenConnectionStringsModal(TenantDto t)
    {
        _currentManagingTenant = t;
        _customConnString = string.Empty;
        _showConnModal = true;

        try
        {
            _customConnString = await TenantAppService.GetDefaultConnectionStringAsync(t.Id) ?? string.Empty;
        }
        catch
        {
        }
    }

    private async Task SaveConnectionStringAsync()
    {
        if (_currentManagingTenant == null) return;
        try
        {
            await TenantAppService.UpdateDefaultConnectionStringAsync(_currentManagingTenant.Id, _customConnString);
            CloseModal();
        }
        catch
        {
        }
    }

    private async Task DeleteConnectionStringAsync()
    {
        if (_currentManagingTenant == null) return;
        try
        {
            await TenantAppService.DeleteDefaultConnectionStringAsync(_currentManagingTenant.Id);
            _customConnString = string.Empty;
            CloseModal();
        }
        catch
        {
        }
    }

    private void CloseModal()
    {
        _showEditModal = false;
        _showConnModal = false;
    }
}
