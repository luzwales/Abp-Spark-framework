@page "/menus"
@attribute [Authorize]
@inject IMenuAppService MenuAppService
@inject NavigationManager NavigationManager

<PageTitle>@L["Menus"]</PageTitle>

<section class="space-y-6">
    <!-- Breadcrumb & Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <ul class="flex items-center gap-2 text-xs text-[#888ea8] mb-1 font-semibold">
                <li><a href="/" class="hover:text-primary transition-colors">@L["home"]</a></li>
                <li><span>/</span></li>
                <li><a href="/dashboard" class="hover:text-primary transition-colors">@L["Dashboard"]</a></li>
                <li><span>/</span></li>
                <li class="text-primary font-bold">@L["Menus"]</li>
            </ul>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0e1726] dark:text-white font-nunito flex items-center gap-3">
                <LucideIcon Name="Menu" Class="w-7 h-7 text-primary" />
                <span>@L["Menus"]</span>
            </h1>
        </div>

        <div class="flex items-center gap-2">
            <button type="button"
                    class="btn btn-primary btn-sm flex items-center gap-2 shadow-sm font-bold text-xs"
                    onclick="@(() => OpenModal(null))">
                <LucideIcon Name="FolderPlus" Class="w-4 h-4 text-white" />
                <span>+ 新增菜单 / 分组</span>
            </button>
        </div>
    </div>

    <!-- Alert / Tips Card -->
    <div class="card bg-white dark:bg-[#0e1726] shadow-sm rounded-2xl p-4 border border-gray-100 dark:border-[#1b2e4b] flex items-center justify-between text-xs text-[#506690] dark:text-[#888ea8]">
        <div class="flex items-center gap-2.5">
            <span class="w-2.5 h-2.5 rounded-full bg-primary animate-pulse"></span>
            <span>动态侧边栏由菜单配置（MenuConfig）驱动，支持按角色/用户绑定细粒度权限代码（PermissionName）。</span>
        </div>
        <div class="font-mono text-[11px] font-bold text-primary">
            总计: @_flatMenus.Count 个节点
        </div>
    </div>

    <!-- Table Container -->
    <div class="card bg-white dark:bg-[#0e1726] shadow-sm rounded-2xl overflow-hidden border border-gray-100 dark:border-[#1b2e4b]">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-[#506690] dark:text-[#888ea8]">
                <thead>
                    <tr class="border-b border-gray-100 dark:border-[#191e3a] text-[#0e1726] dark:text-white font-extrabold uppercase tracking-wider text-[11px] bg-gray-50/50 dark:bg-[#121e32]/40">
                        <th class="py-3 px-4">层级与标识</th>
                        <th class="py-3 px-4">类型</th>
                        <th class="py-3 px-4">路由地址</th>
                        <th class="py-3 px-4">图标</th>
                        <th class="py-3 px-4">绑定权限代码 (Permission)</th>
                        <th class="py-3 px-4 text-center">排序</th>
                        <th class="py-3 px-4 text-center">状态</th>
                        <th class="py-3 px-4 text-right">操作</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-[#191e3a]">
                    @if (!_flatMenus.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-12 text-[#888ea8]">
                                暂无菜单配置数据
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in _flatMenus)
                        {
                            <tr class="hover:bg-[#f8f9fa] dark:hover:bg-[#121e32]/60 transition-colors @(item.IsGroup ? "bg-gray-50/30 dark:bg-[#121e32]/20 font-bold" : "")">
                                <td class="py-3.5 px-4">
                                    <div class="flex items-center gap-2" style="padding-left: @(item.Level * 20)px;">
                                        @if (item.IsGroup)
                                        {
                                            <LucideIcon Name="Folder" Class="w-4 h-4 text-secondary shrink-0" />
                                        }
                                        else
                                        {
                                            <span class="w-1.5 h-1.5 rounded-full bg-primary/40 shrink-0"></span>
                                        }
                                        <div>
                                            <span class="text-[#0e1726] dark:text-white font-bold">@item.Dto.Name</span>
                                            <span class="text-[10px] text-[#888ea8] ml-1.5 font-normal">(@item.Dto.Label)</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4">
                                    @if (item.IsGroup)
                                    {
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-secondary/10 text-secondary">
                                            GROUP 分组
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-primary/10 text-primary">
                                            LINK 链接
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 font-mono text-[11px] text-[#0e1726] dark:text-white">
                                    @(string.IsNullOrEmpty(item.Dto.Route) ? "-" : item.Dto.Route)
                                </td>
                                <td class="py-3.5 px-4">
                                    <div class="flex items-center gap-1.5">
                                        <LucideIcon Name="@(item.Dto.Icon ?? "Circle")" Class="w-4 h-4 text-primary" />
                                        <span class="text-[11px] font-mono">@(item.Dto.Icon ?? "None")</span>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4">
                                    @if (string.IsNullOrEmpty(item.Dto.PermissionName))
                                    {
                                        <span class="text-[#888ea8] italic">公开 / 登录即可见</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-success/10 text-success">
                                            @item.Dto.PermissionName
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-center font-mono font-bold">
                                    @item.Dto.SortOrder
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    @if (item.Dto.IsActive)
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-success/15 text-success">已启用</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-danger/15 text-danger">已禁用</span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <button type="button"
                                                class="px-2 py-1 rounded hover:bg-gray-100 dark:hover:bg-[#191e3a] text-primary transition font-semibold"
                                                onclick="@(() => OpenModal(item.Dto))">
                                            编辑
                                        </button>
                                        <button type="button"
                                                class="px-2 py-1 rounded hover:bg-danger/10 text-danger transition font-semibold"
                                                onclick="@(() => DeleteMenu(item.Dto.Id))">
                                            删除
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- Modal: Create / Edit Menu -->
@if (_isModalOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs">
        <div class="card bg-white dark:bg-[#0e1726] shadow-2xl rounded-2xl max-w-lg w-full border border-gray-100 dark:border-[#1b2e4b] overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 dark:border-[#191e3a] flex items-center justify-between">
                <h3 class="text-base font-bold text-[#0e1726] dark:text-white flex items-center gap-2">
                    <LucideIcon Name="@(_editingId.HasValue ? "SquarePen" : "PlusCircle")" Class="w-5 h-5 text-primary" />
                    <span>@(_editingId.HasValue ? "编辑菜单配置" : "新建菜单项 / 分组")</span>
                </h3>
                <button type="button" class="text-[#888ea8] hover:text-[#0e1726] dark:hover:text-white" onclick="@CloseModal">
                    ✕
                </button>
            </div>

            <div class="p-6 space-y-4 text-xs">
                @if (!string.IsNullOrEmpty(_modalError))
                {
                    <div class="p-3 rounded-lg bg-danger/10 text-danger font-semibold">
                        @_modalError
                    </div>
                }

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block font-semibold text-[#0e1726] dark:text-white mb-1.5">上级节点 (Parent)</label>
                        <select @bind="_form.ParentId" class="select select-bordered select-sm w-full bg-transparent">
                            <option value="">[顶层独立项 / 根节点]</option>
                            @foreach (var g in _groupMenus)
                            {
                                <option value="@g.Id">📂 @g.Name (@g.Label)</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block font-semibold text-[#0e1726] dark:text-white mb-1.5">节点类型 (Type)</label>
                        <select @bind="_form.Type" class="select select-bordered select-sm w-full bg-transparent">
                            <option value="@SidebarItemType.Link">链接 (Link)</option>
                            <option value="@SidebarItemType.Group">分组 (Group)</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block font-semibold text-[#0e1726] dark:text-white mb-1.5">唯一标识 (Name) *</label>
                        <input type="text" @bind="_form.Name" placeholder="如 MenuManagement" class="input input-bordered input-sm w-full bg-transparent" />
                    </div>
                    <div>
                        <label class="block font-semibold text-[#0e1726] dark:text-white mb-1.5">显示名称/多语言Key (Label) *</label>
                        <input type="text" @bind="_form.Label" placeholder="如 Menus" class="input input-bordered input-sm w-full bg-transparent" />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block font-semibold text-[#0e1726] dark:text-white mb-1.5">路由地址 (Route)</label>
                        <input type="text" @bind="_form.Route" placeholder="如 /menus" class="input input-bordered input-sm w-full bg-transparent" />
                    </div>
                    <div>
                        <label class="block font-semibold text-[#0e1726] dark:text-white mb-1.5">Lucide 图标名 (Icon)</label>
                        <input type="text" @bind="_form.Icon" placeholder="如 Menu / Settings" class="input input-bordered input-sm w-full bg-transparent" />
                    </div>
                </div>

                <div>
                    <label class="block font-semibold text-[#0e1726] dark:text-white mb-1.5">
                        绑定权限代码 (PermissionName)
                    </label>
                    <input type="text" @bind="_form.PermissionName" placeholder="留空则登录可见，如 Spark.Menus 或 AbpIdentity.Users" class="input input-bordered input-sm w-full bg-transparent font-mono" />
                    <p class="text-[10px] text-[#888ea8] mt-1">
                        当用户/角色拥有该权限时才会在侧边栏渲染该项；留空表示所有已登录用户默认可见。
                    </p>
                </div>

                <div class="grid grid-cols-2 gap-4 pt-1">
                    <div>
                        <label class="block font-semibold text-[#0e1726] dark:text-white mb-1.5">排序权重 (SortOrder)</label>
                        <input type="number" @bind="_form.SortOrder" class="input input-bordered input-sm w-full bg-transparent" />
                    </div>
                    <div class="flex items-center pt-6">
                        <label class="label cursor-pointer gap-2">
                            <input type="checkbox" @bind="_form.IsActive" class="checkbox checkbox-primary checkbox-sm rounded" />
                            <span class="label-text text-xs text-[#0e1726] dark:text-white font-semibold">启用该菜单</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="px-6 py-4 bg-gray-50 dark:bg-[#121e32]/60 border-t border-gray-100 dark:border-[#191e3a] flex items-center justify-end gap-3">
                <button type="button" class="btn btn-ghost btn-sm text-xs" onclick="@CloseModal">取消</button>
                <button type="button" class="btn btn-primary btn-sm text-xs font-bold" onclick="@SaveMenu">保存并生效</button>
            </div>
        </div>
    </div>
}

@code {
    private List<MenuDto> _rawMenus = new();
    private List<FlatMenuItem> _flatMenus = new();
    private List<MenuDto> _groupMenus = new();

    private bool _isModalOpen = false;
    private Guid? _editingId = null;
    private CreateUpdateMenuDto _form = new();
    private string? _modalError = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _rawMenus = await MenuAppService.GetAllAsync();
            _flatMenus.Clear();
            FlattenTree(_rawMenus, 0);

            _groupMenus = _rawMenus
                .Where(m => m.Type == SidebarItemType.Group)
                .OrderBy(m => m.SortOrder)
                .ToList();
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to load menus");
        }
    }

    private void FlattenTree(List<MenuDto> nodes, int level)
    {
        foreach (var node in nodes.OrderBy(n => n.SortOrder))
        {
            _flatMenus.Add(new FlatMenuItem
            {
                Dto = node,
                Level = level,
                IsGroup = node.Type == SidebarItemType.Group
            });

            if (node.Children.Any())
            {
                FlattenTree(node.Children, level + 1);
            }
        }
    }

    private void OpenModal(MenuDto? dto)
    {
        _modalError = null;
        if (dto != null)
        {
            _editingId = dto.Id;
            _form = new CreateUpdateMenuDto
            {
                ParentId = dto.ParentId,
                Name = dto.Name,
                Label = dto.Label,
                Icon = dto.Icon,
                Route = dto.Route,
                Type = dto.Type,
                SortOrder = dto.SortOrder,
                PermissionName = dto.PermissionName,
                IsActive = dto.IsActive
            };
        }
        else
        {
            _editingId = null;
            _form = new CreateUpdateMenuDto
            {
                Type = SidebarItemType.Link,
                SortOrder = (_flatMenus.Count + 1) * 5,
                IsActive = true
            };
        }
        _isModalOpen = true;
    }

    private void CloseModal()
    {
        _isModalOpen = false;
        _editingId = null;
    }

    private async Task SaveMenu()
    {
        if (string.IsNullOrWhiteSpace(_form.Name) || string.IsNullOrWhiteSpace(_form.Label))
        {
            _modalError = "标识(Name)和标签(Label)不能为空";
            return;
        }

        try
        {
            if (_editingId.HasValue)
            {
                await MenuAppService.UpdateAsync(_editingId.Value, _form);
            }
            else
            {
                await MenuAppService.CreateAsync(_form);
            }
            CloseModal();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _modalError = ex.Message;
        }
    }

    private async Task DeleteMenu(Guid id)
    {
        try
        {
            await MenuAppService.DeleteAsync(id);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to delete menu");
        }
    }

    public class FlatMenuItem
    {
        public MenuDto Dto { get; set; } = default!;
        public int Level { get; set; }
        public bool IsGroup { get; set; }
    }
}
