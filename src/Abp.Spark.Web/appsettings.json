{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\mssqllocaldb;Database=AbpSparkDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Database": {
    "Provider": "SqlServer",
    "_providerExamples": {
      "SqlServer": "Server=(localdb)\\mssqllocaldb;Database=AbpSparkDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
      "PostgreSql": "Host=localhost;Database=AbpSparkDb;Username=postgres;Password=[REDACTED]",
      "MySql": "Server=localhost;Database=AbpSparkDb;User=root;Password=[REDACTED];",
      "Sqlite": "Data Source=Storage/abp_spark.db"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Volo.Abp": "Information"
      }
    }
  },
  "Vite": {
    "Server": {
      "Port": 5173
    }
  },
  "AllowedHosts": "*"
}
