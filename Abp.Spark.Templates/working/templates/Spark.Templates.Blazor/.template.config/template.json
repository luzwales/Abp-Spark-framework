{
    "$schema": "http://json.schemastore.org/template",
    "author": "Andrew Lu",
    "classifications": [ "Web", "Blazor", "ABP", "DDD", "Spark" ],
    "name": "Abp.Spark Web App (ABP vNext + Blazor Monolith)",
    "identity": "Abp.Spark.Templates.Blazor",
    "shortName": "sparkblazor",
    "tags": {
        "language": "C#",
        "type": "project"
    },
    "preferNameDirectory": true,
    "symbols": {
        "CustomerName": {
            "type": "parameter",
            "dataType": "string",
            "defaultValue": "Abp",
            "description": "Customer name for namespace prefix (e.g. Acme)"
        },
        "ProjectName": {
            "type": "parameter",
            "dataType": "string",
            "defaultValue": "Spark",
            "description": "Project name (e.g. Shop)"
        },
        "FullNamespace": {
            "type": "generated",
            "generator": "join",
            "parameters": {
                "symbols": [
                    { "type": "ref", "value": "CustomerName" },
                    { "type": "ref", "value": "ProjectName" }
                ],
                "separator": "."
            },
            "replaces": "Abp.Spark",
            "fileRename": "Abp.Spark"
        },
        "CompactPrefix": {
            "type": "generated",
            "generator": "join",
            "parameters": {
                "symbols": [
                    { "type": "ref", "value": "CustomerName" },
                    { "type": "ref", "value": "ProjectName" }
                ],
                "separator": ""
            },
            "replaces": "AbpSpark",
            "fileRename": "AbpSpark"
        },
        "DbProvider": {
            "type": "parameter",
            "datatype": "choice",
            "choices": [
                {
                    "choice": "SqlServer",
                    "description": "Microsoft SQL Server"
                },
                {
                    "choice": "PostgreSql",
                    "description": "PostgreSQL"
                },
                {
                    "choice": "MySql",
                    "description": "MySQL"
                },
                {
                    "choice": "Sqlite",
                    "description": "SQLite"
                }
            ],
            "defaultValue": "SqlServer",
            "description": "Database provider",
            "replaces": "SqlServer"
        },
        "DefaultConnection": {
            "type": "generated",
            "generator": "switch",
            "replaces": "Server=(localdb)\\\\mssqllocaldb;Database=AbpSparkCoreDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
            "parameters": {
                "evaluator": "C++",
                "datatype": "string",
                "cases": [
                    {
                        "condition": "(DbProvider == 'PostgreSql')",
                        "value": "Host=localhost;Database=AbpSparkDb;Username=postgres;Password=your_password"
                    },
                    {
                        "condition": "(DbProvider == 'MySql')",
                        "value": "Server=localhost;Database=AbpSparkDb;User=root;Password=your_password;"
                    },
                    {
                        "condition": "(DbProvider == 'Sqlite')",
                        "value": "Data Source=Storage/abp_spark.db"
                    },
                    {
                        "condition": "(DbProvider == 'SqlServer')",
                        "value": "Server=(localdb)\\\\mssqllocaldb;Database=AbpSparkCoreDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
                    }
                ]
            }
        }
    },
    "sources": [
        {
            "modifiers": [
                {
                    "exclude": [
                        "**/bin/**",
                        "**/obj/**",
                        "**/node_modules/**",
                        "**/.vs/**",
                        "**/.vscode/**",
                        "**/.idea/**",
                        "**/*.user"
                    ]
                }
            ]
        }
    ]
}
